#!/bin/bash
# Update everything on tinyraven in one go, then free disk space.
# The internal disk is 14 GB, so the cleanup matters as much as the update.
# Run from a terminal: it asks for your sudo password.

set -uo pipefail
step() { printf '\n\033[1;37m■ %s\033[0m\n' "$*"; }
free_now() { df -h --output=avail / | tail -1 | xargs; }
before=$(free_now)

step "System packages"
sudo pacman -Syu || { echo "pacman failed; nothing else was changed"; exit 1; }

step "AUR packages"
yay -Sua --noconfirm || echo "! AUR update had problems (system packages are already updated)"

step "Free disk space"
sudo paccache -rk1 -q || true                         # keep one old version of each package
sudo paccache -ruk0 -q || true                        # drop downloads of packages no longer installed
sudo journalctl --vacuum-size=100M >/dev/null 2>&1    # cap the system log
echo "Free on the disk: $before before, $(free_now) now."

orphans=$(pacman -Qdtq 2>/dev/null)
if [[ -n $orphans ]]; then
    step "Unused packages (not removed): $(echo $orphans | wc -w)"
    echo "Remove with: sudo pacman -Rns \$(pacman -Qdtq)"
fi

# A kernel update removes the running kernel's module folder
if [[ ! -d /usr/lib/modules/$(uname -r) ]]; then
    step "Kernel updated: restart to use it"
fi

printf '\n\033[1;37m■ tinyraven is up to date.\033[0m\n'
