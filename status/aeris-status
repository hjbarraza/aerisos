#!/usr/bin/env python3
"""Collect live machine info for the AerisOS login screen.

Runs as root from aeris-status.timer (at boot, then every minute) and writes
/var/lib/aeris/status.json, which the SDDM theme reads. Every field is
best-effort: anything unavailable becomes "—" instead of failing.

Location comes from the public IP (ipinfo.io, city-level) and weather from
Open-Meteo. The intelligence row adds aircraft overhead (adsb.fi), GPS jamming
(GPSJAM), satellite passes (CelesTrak elements, propagated here), space weather
(NOAA SWPC), headlines (defence, intelligence and cyber feeds, plus BBC and Al Jazeera filtered to those topics) and
internet outages (IODA). None need a key. Ping and DNS times are measured here.
Network sources are cached; offline, the last values are kept and marked stale.
"""
import email.utils
import glob
import gzip
import json
import math
import os
import pwd
import random
import re
import socket
import subprocess
import time
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timezone
from xml.etree import ElementTree

OUT_DIR = "/var/lib/aeris"
OUT = os.path.join(OUT_DIR, "status.json")
# Serial and public IP: readable by USER only (mode 600), for the terminal greeting
PRIVATE = os.path.join(OUT_DIR, "private.json")
LOCK = os.path.join(OUT_DIR, "lock.tsv")  # the lock screen's view of status.json, one "key<TAB>text" per line
USER = os.environ.get("AERIS_USER", "h")
NA = "—"


def read(path, default=NA):
    try:
        with open(path) as f:
            return f.read().strip() or default
    except OSError:
        return default


def run(*cmd, timeout=5):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def fetch(url, timeout=4):
    req = urllib.request.Request(url, headers={"User-Agent": "aeris-status", "Accept-Encoding": "gzip"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        body = r.read()
    return gzip.decompress(body) if body[:2] == b"\x1f\x8b" else body


def fetch_json(url, timeout=4):
    return json.loads(fetch(url, timeout))


def cached(name, ttl, fn):
    """fn() if the cache is older than ttl; on failure, the last values marked stale."""
    path = os.path.join(OUT_DIR, f"{name}-cache.json")
    try:
        with open(path) as f:
            cache = json.load(f)
        if time.time() - cache.get("_at", 0) < ttl:
            return cache
    except (OSError, ValueError):
        cache = {}
    try:
        data = {"_at": time.time(), "_fetched": time.time(), **fn()}
    except Exception:
        # Keep the last values and back off up to 5 minutes, so a rate limit can clear
        data = {**cache, "stale": True} if cache else {"offline": True}
        data["_at"] = time.time() - ttl + min(ttl, 300)
    os.makedirs(OUT_DIR, exist_ok=True)
    with open(path, "w") as f:
        json.dump(data, f, ensure_ascii=False)
    return data


def fresh(data):
    """When a cached source was last fetched: "14:13", "14:01 STALE" after a failed refresh, or "NO DATA"."""
    # Caches from before _fetched existed: their _at is the fetch time unless a retry moved it
    at = data.get("_fetched") or (None if data.get("stale") else data.get("_at"))
    if not at:
        return "NO DATA"
    return time.strftime("%H:%M", time.localtime(at)) + (" STALE" if data.get("stale") else "")


def human_duration(seconds):
    seconds = int(seconds)
    d, rem = divmod(seconds, 86400)
    h, rem = divmod(rem, 3600)
    m = rem // 60
    return f"{d}D {h}H {m}M" if d else f"{h}H {m}M"


# ---------- identity ----------

def identity():
    product = read("/sys/class/dmi/id/product_name").split(" - ")[0]
    vendor = read("/sys/class/dmi/id/sys_vendor")
    cpu = re.sub(r".*\)\s*", "", run("sh", "-c", "lscpu | sed -n 's/^Model name: *//p'"))
    gpus = []
    for line in run("lspci").splitlines():
        if re.search(r"VGA|3D|Display", line):
            m = re.search(r"\[([^\]]+)\]", line.split(": ", 1)[-1])
            if m:
                gpus.append(re.sub(r"(?i)geforce |laptop gpu| graphics", "", m.group(1)).strip())
    mem_kb = int(re.search(r"MemTotal:\s+(\d+)", read("/proc/meminfo", "MemTotal: 0")).group(1))
    boot = run("systemd-analyze")
    boot_s = re.search(r"=\s*([\d.]+)s", boot)
    return {
        "host": read("/etc/hostname").upper(),
        "model": f"{vendor} {product}".upper(),
        "cpu": cpu.upper() or NA,
        "gpu": " · ".join(gpus).upper() or NA,
        "ram": f"{round(mem_kb / 1048576)} GB",
        "kernel": os.uname().release.upper(),
        "boot": f"{float(boot_s.group(1)):.1f} S" if boot_s else NA,
    }


# ---------- live state ----------

def live_state():
    bat = (glob.glob("/sys/class/power_supply/BAT*") or [""])[0]
    capacity = read(f"{bat}/capacity") if bat else NA
    bstatus = read(f"{bat}/status", "").upper() if bat else ""
    temp = NA
    for zone in glob.glob("/sys/class/thermal/thermal_zone*"):
        if read(f"{zone}/type", "") in ("x86_pkg_temp", "TCPU"):
            temp = f"{int(read(f'{zone}/temp', '0')) // 1000}°C"
            break
    ssid, signal = NA, ""
    for line in run("nmcli", "-t", "-f", "ACTIVE,SSID,SIGNAL", "dev", "wifi").splitlines():
        if line.startswith("yes:"):
            _, ssid, signal = line.rsplit(":", 2) if line.count(":") >= 2 else (line, NA, "")
            ssid = ssid or NA
            break
    lan = re.search(r"src (\S+)", run("ip", "-4", "-o", "route", "get", "1.1.1.1"))
    uptime = float(read("/proc/uptime", "0").split()[0])
    df = run("df", "-h", "--output=used,size", "/").splitlines()
    disk = " / ".join(df[-1].split()) if len(df) > 1 else NA
    return {
        "battery": f"{capacity}%" if capacity != NA else NA,
        "power": bstatus.replace("NOT CHARGING", "AC").replace("DISCHARGING", "BATTERY") or NA,
        "cpu_temp": temp,
        "wifi": ssid.upper(),
        "signal": f"{signal}%" if signal else NA,
        "lan": lan.group(1) if lan else NA,
        "uptime": human_duration(uptime),
        "disk": disk,
    }


