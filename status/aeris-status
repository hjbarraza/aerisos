def coord(value, pos, neg):
    return f"{abs(value):.4f}° {pos if value >= 0 else neg}"


def location_weather():
    # The public IP goes to private.json only, never into the cache or status.json
    ip = fetch_json("https://ipinfo.io/json")
    WAN["ip"] = ip.get("ip", NA)
    lat, lon = (float(x) for x in ip["loc"].split(","))
    w = fetch_json(
        "https://api.open-meteo.com/v1/forecast"
        f"?latitude={lat}&longitude={lon}"
        "&current=temperature_2m,weather_code,wind_speed_10m,relative_humidity_2m"
        "&daily=sunrise,sunset&timezone=auto&forecast_days=1"
    )
    cur = w["current"]
    en, ja = WEATHER.get(int(cur["weather_code"]), ("—", "—"))
    return {
        "lat": lat,
        "lon": lon,
        "city": f'{ip.get("city", "")}, {ip.get("country", "")}'.upper().strip(", ") or NA,
        "coords": f"{coord(lat, 'N', 'S')}  {coord(lon, 'E', 'W')}",
        "timezone": ip.get("timezone", NA).upper(),
        "temp": f'{round(cur["temperature_2m"])}°C',
        "sky": en,
        "sky_ja": ja,
        "wind": f'{round(cur["wind_speed_10m"])} KM/H',
        "humidity": f'{round(cur["relative_humidity_2m"])}%',
        "sunrise": w["daily"]["sunrise"][0][-5:],
        "sunset": w["daily"]["sunset"][0][-5:],
        "alt": f'{round(w.get("elevation", 0))} M' if "elevation" in w else NA,
    }


WAN = {}  # set by location_weather when it refreshes


def network_info():
    return cached("net", 15 * 60, location_weather)


def write_private():
    """Serial (root-only in sysfs) and public IP, for USER's terminal greeting only."""
    try:
        with open(PRIVATE) as f:
            last = json.load(f)
    except (OSError, ValueError):
        last = {}
    data = {"serial": read("/sys/class/dmi/id/product_serial"),
            "public_ip": WAN.get("ip") or last.get("public_ip", NA)}
    tmp = PRIVATE + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(data, f)
    os.chmod(tmp, 0o600)
    try:
        pw = pwd.getpwnam(USER)
        os.chown(tmp, pw.pw_uid, pw.pw_gid)
    except KeyError:
        pass
    os.replace(tmp, PRIVATE)


# ---------- airspace: aircraft overhead + GPS jamming ----------

RADIUS_NM = 27  # 50 km


def aircraft(lat, lon):
    ac = fetch_json(f"https://opendata.adsb.fi/api/v2/lat/{lat:.4f}/lon/{lon:.4f}/dist/{RADIUS_NM}")["aircraft"]
    flying = [a for a in ac if isinstance(a.get("alt_baro"), (int, float))]
    out = {"traffic": f"{len(flying)} AIRCRAFT · 50 KM", "nearest": NA}
    if flying:
        a = min(flying, key=lambda a: a.get("dst", 1e9))
        name = (a.get("flight") or a.get("r") or a.get("hex", "")).strip()
        # Fits the 21-character value column: "RYR2495X B38M FL370", "VLG3GG A320 1675 FT"
        alt = a["alt_baro"]
        level = f"FL{round(alt / 100):03d}" if alt >= 18000 else f"{alt} FT"
        out["nearest"] = f'{name} {a.get("t", "")} {level}'.upper()
    out["mil"] = str(sum(1 for a in ac if (a.get("dbFlags") or 0) & 1))
    emergencies = sorted({a["squawk"] for a in ac if a.get("squawk") in ("7500", "7600", "7700")}
                         | {a["emergency"].upper() for a in ac if a.get("emergency") not in (None, "none")})
    out["emergency"] = " ".join(emergencies) or "NONE"
    # GPSJAM's method, live: airborne aircraft reporting low navigation accuracy (NACp < 8).
    # Surface targets are excluded: aerodrome beacons and ground vehicles report NACp 0 as a
    # matter of course (the El Prat tower alone was turning a 13-aircraft sample into "LOW").
    # One bad contact is never enough either -- uncertified GA GPS sets read 0 with no
    # interference at all -- so LOW needs two and JAMMED three plus a >10% share.
    rated = [a["nac_p"] for a in ac
             if isinstance(a.get("nac_p"), int)
             and isinstance(a.get("alt_baro"), (int, float)) and a["alt_baro"] >= 1000]
    if not rated:
        out["gnss"] = NA
    else:
        bad = sum(1 for n in rated if n < 8)
        share = bad / len(rated)
        word = "JAMMED" if bad >= 3 and share > 0.10 else "LOW" if bad >= 2 else "OK"
        out["gnss"] = f"{word} {bad}/{len(rated)}"
    return out


def gps_jamming():
    # Last row of the manifest: date, suspect, number of world hexes with jammed aircraft
    last = fetch("https://gpsjam.org/data/manifest.csv", timeout=8).decode().strip().splitlines()[-1].split(",")
    return {"jam_zones": f"{int(last[2]):,} ZONES", "jam_date": last[0]}


def airspace(lat, lon):
    air = cached("air", 50, lambda: aircraft(lat, lon))
    return {**cached("gpsjam", 6 * 3600, gps_jamming), **air, "fresh": fresh(air)}


# ---------- orbit: next ISS / Tiangong passes + space weather ----------
# Mean elements with J2 precession: within a few seconds of SGP4 for a pass a day ahead.

MU, RE, J2 = 398600.4418, 6378.137, 1.08262668e-3
WGS84_E2 = (1 / 298.257223563) * (2 - 1 / 298.257223563)
STATIONS = {"ISS": "ISS (ZARYA)", "CSS": "CSS (TIANHE)"}


def station_elements():
    lines = fetch("https://celestrak.org/NORAD/elements/gp.php?GROUP=stations&FORMAT=TLE", timeout=8).decode().splitlines()
    tles = {lines[i].strip(): (lines[i + 1], lines[i + 2]) for i in range(0, len(lines) - 2, 3)}
    return {key: tles[name] for key, name in STATIONS.items() if name in tles}


def parse_tle(l1, l2):
    year, day = int(l1[18:20]), float(l1[20:32])
    epoch = datetime(2000 + year, 1, 1, tzinfo=timezone.utc).timestamp() + (day - 1) * 86400
    return {
        "epoch": epoch, "ndot2": float(l1[33:43]),
        "i": math.radians(float(l2[8:16])), "raan": math.radians(float(l2[17:25])),
        "e": float("0." + l2[26:33]), "argp": math.radians(float(l2[34:42])),
        "m": float(l2[43:51]), "n": float(l2[52:63]),
    }


def sat_ecef(s, t):
    dt = (t - s["epoch"]) / 86400
    n = (s["n"] + 2 * s["ndot2"] * dt) * 2 * math.pi / 86400
    a = (MU / n ** 2) ** (1 / 3)
    e, i = s["e"], s["i"]
    k = 1.5 * J2 * (RE / (a * (1 - e * e))) ** 2 * n * dt * 86400
    raan = s["raan"] - k * math.cos(i)
    argp = s["argp"] + k / 2 * (5 * math.cos(i) ** 2 - 1)
    m = math.radians(s["m"] + 360 * (s["n"] * dt + s["ndot2"] * dt * dt))
    ea = m
    for _ in range(6):
        ea -= (ea - e * math.sin(ea) - m) / (1 - e * math.cos(ea))
    xp, yp = a * (math.cos(ea) - e), a * math.sqrt(1 - e * e) * math.sin(ea)
    co, so, cw, sw, ci, si = math.cos(raan), math.sin(raan), math.cos(argp), math.sin(argp), math.cos(i), math.sin(i)
    x = (co * cw - so * sw * ci) * xp + (-co * sw - so * cw * ci) * yp
    y = (so * cw + co * sw * ci) * xp + (-so * sw + co * cw * ci) * yp
    z = sw * si * xp + cw * si * yp
    gmst = math.radians((280.46061837 + 360.98564736629 * (t / 86400 - 10957.5)) % 360)
    return x * math.cos(gmst) + y * math.sin(gmst), -x * math.sin(gmst) + y * math.cos(gmst), z


def elevation(s, t, obs, up):
    d = [p - o for p, o in zip(sat_ecef(s, t), obs)]
    return math.degrees(math.asin(sum(a * b for a, b in zip(d, up)) / math.sqrt(sum(a * a for a in d))))


def observer(lat, lon):
    """ECEF position and local up unit vector for a ground observer."""
    la, lo = math.radians(lat), math.radians(lon)
    nr = RE / math.sqrt(1 - WGS84_E2 * math.sin(la) ** 2)
    obs = (nr * math.cos(la) * math.cos(lo), nr * math.cos(la) * math.sin(lo), nr * (1 - WGS84_E2) * math.sin(la))
    up = (math.cos(la) * math.cos(lo), math.cos(la) * math.sin(lo), math.sin(la))
    return obs, up


def next_pass(s, lat, lon, now, min_el=10, step=20):
    """'HH:MM · MAX° · N MIN' for the next pass above min_el within a day ('NOW' if overhead)."""
    obs, up = observer(lat, lon)
    t = now
    while t < now + 86400 and elevation(s, t, obs, up) < min_el:
        t += step
    if t >= now + 86400:
        return NA
    start, top = t, 0
    while (el := elevation(s, t, obs, up)) >= min_el:
        top, t = max(top, el), t + step
    when = "NOW" if start == now else time.strftime("%H:%M", time.localtime(start))
    return f"{when} · {round(top)}° · {max(1, round((t - start) / 60))} MIN"


def space_weather():
    scales = fetch_json("https://services.swpc.noaa.gov/products/noaa-scales.json")["0"]
    kp = float(fetch_json("https://services.swpc.noaa.gov/products/noaa-planetary-k-index.json")[-1]["Kp"])
    flares = fetch_json("https://services.swpc.noaa.gov/json/goes/primary/xray-flares-latest.json")
    return {
        "kp": f"{kp:.1f} " + ("QUIET" if kp < 4 else "ACTIVE" if kp < 5 else f"STORM G{min(5, int(kp) - 4)}"),
        "flare": (flares[0].get("max_class") or NA) if flares else NA,
        "scales": " ".join(f"{k}{scales[k]['Scale'] or 0}" for k in ("R", "S", "G")),
    }


def visual_elements():
    """TLEs of CelesTrak's 'visual' group: the ~170 brightest satellites."""
    lines = fetch("https://celestrak.org/NORAD/elements/gp.php?GROUP=visual&FORMAT=TLE", timeout=10).decode().splitlines()
    return {"sats": [[lines[i].strip(), lines[i + 1], lines[i + 2]] for i in range(0, len(lines) - 2, 3)]}


def next_launch():
    """The next launch worldwide, from The Space Devs' free Launch Library 2 (hourly cache)."""
    first = fetch_json("https://ll.thespacedevs.com/2.2.0/launch/upcoming/?limit=1&mode=list", 8)["results"][0]
    vehicle, _, mission = (p.strip() for p in first.get("name", "").partition("|"))
    status = first.get("status") or {}
    when = datetime.fromisoformat(first.get("net", "").replace("Z", "+00:00")).astimezone()
    return {"mission": (mission or vehicle).upper(), "vehicle": vehicle.upper(),
            "t0": when.strftime("%d %b %H:%M").upper(),
            "status": (status.get("abbrev", "") if isinstance(status, dict) else str(status)).upper()}


def orbit(lat, lon):
    swpc = cached("swpc", 15 * 60, space_weather)
    out = {**swpc, "fresh": fresh(swpc)}
    tles = cached("tle", 12 * 3600, station_elements)
    now = time.time()
    for key in STATIONS:
        out[key.lower()] = next_pass(parse_tle(*tles[key]), lat, lon, now) if key in tles else NA
    # Bright satellites above 10° elevation right now, highest first
    vis, obs_up = cached("vistle", 12 * 3600, visual_elements), observer(lat, lon)
    over = []
    for name, l1, l2 in vis.get("sats") or []:
        try:
            el = elevation(parse_tle(l1, l2), now, *obs_up)
        except (ValueError, IndexError, ZeroDivisionError):
            continue
        if el >= 10:
            over.append((el, re.sub(r"\s*\(.*", "", name)))
    over.sort(reverse=True)
    out["sats"] = f"{len(over)} O/H" + (f" · {cut(over[0][1], 24)}" if over else "")
    launch = cached("launch", 60 * 60, next_launch)
    out["launch"] = cut(launch.get("mission") or NA, 20)
    out["launch_t0"] = " · ".join(x for x in (launch.get("t0"), launch.get("status")) if x) or NA
    return out


# ---------- world: headlines + internet outages ----------

NEWS_WIDTH = 44  # characters per line in the right column's news card
NEWS_ITEMS = 12  # more than either screen shows; each keeps as many whole stories as fit


def clean_title(title):
    # GDELT spaces out punctuation: "India - backed", "Balochistan : ISPR"
    title = re.sub(r"(\w) - (\w)", r"\1-\2", title)
    return re.sub(r" ([:,.;!?]|'s)", r"\1", title).upper()


def wrap(title, width=NEWS_WIDTH, most=3):
    """Whole headline in lines of at most width characters (mono font), the last cut if needed."""
    lines, line = [], ""
    for word in title.split():
        if line and len(line) + 1 + len(word) > width:
            lines.append(line)
            line = word
        else:
            line = f"{line} {word}" if line else word
    lines.append(line)
    lines = [l if len(l) <= width else l[:width - 1] + "…" for l in lines]
    if len(lines) > most:
        lines = lines[:most]
        lines[-1] = cut(lines[-1] + " …", width) if len(lines[-1]) < width - 1 else lines[-1][:width - 1] + "…"
    return lines


def words(title):
    return {w for w in re.findall(r"[A-Z]{4,}", title)}


# ---------- telegram compression: terse one-line headlines via the local Ollama ----------

# Headlines are compressed telegram-style (names, numbers, places; no filler) so one
# 44-character row carries a whole story. Results are memoized on disk, so Ollama is only
# asked about titles it has not seen — a handful of calls when the hourly news or watchlist
# refresh brings new titles, none on the every-minute runs. If Ollama is down or unusable,
# the raw headline is shown instead: the screens never depend on the model.
TG_CACHE = os.path.join(OUT_DIR, "tg-cache.json")
TG_KEEP = 400  # memo entries kept (oldest dropped first)
OLLAMA = "http://127.0.0.1:11434"
TG_MODELS = ("qwen3.5:9b", "qwen3.5-9b-16k:latest", "gemma4:12b", "qwen3.5:4b")  # first available wins
# Ollama down or without a model: OpenRouter instead,
# key from $OPENROUTER_API_KEY, ~/.env or `opencode auth login`
OPENROUTER = "https://openrouter.ai/api/v1/chat/completions"
OR_MODEL = "z-ai/glm-5.3-flash"  # same as AERIS-CLOUD in opencode.json
TG_PROMPT = ("Compress this news headline telegram-style: keep names, numbers and places, "
             "drop articles and filler words. At most {}, ALL CAPS. "
             "Answer with the compressed line only.\n\nHEADLINE: ")
# Watchlist rows already carry the topic's name, so its telegram must not repeat it
TG_ABOUT = ("The line is shown next to the label '{}', so never repeat that name: leave it "
            "implicit, or where grammar needs a subject use THEY or THEIR. ")

_tg_memo = None
_tg_down = False
_tg_model = None


def openrouter_key():
    """$OPENROUTER_API_KEY, else ~/.env (OPENROUTER_API_KEY= or OPENROUTER_KEY=), else the
    key `opencode auth login` saved."""
    key = os.environ.get("OPENROUTER_API_KEY", "")
    try:
        with open(os.path.expanduser(f"~{USER}/.env")) as f:
            for line in f:
                name, _, value = line.strip().removeprefix("export ").partition("=")
                if not key and name in ("OPENROUTER_API_KEY", "OPENROUTER_KEY"):
                    key = value.strip().strip("'\"")
    except OSError:
        pass
    if not key:
        try:
            with open(os.path.expanduser(f"~{USER}/.local/share/opencode/auth.json")) as f:
                key = json.load(f).get("openrouter", {}).get("key", "")
        except (OSError, ValueError, AttributeError):
            pass
    return key


def _tg_backend():
    """("ollama", model) when a local model is installed, else ("openrouter", key)."""
    try:
        tags = [m.get("name", "") for m in fetch_json(f"{OLLAMA}/api/tags", 3).get("models", [])]
    except (OSError, ValueError):
        tags = []
    local = next((m for m in TG_MODELS if m in tags), tags[0] if tags else "")
    if local:
        return ("ollama", local)
    key = openrouter_key()
    if key:
        return ("openrouter", key)
    # An OSError: telegraph() treats it as "model down", shows raw, memoizes nothing
    raise ConnectionError("no local Ollama model and no OpenRouter key")


def _tg_generate(prompt, max_tokens, timeout):
    backend, arg = _tg_model
    if backend == "ollama":
        body = {"model": arg, "prompt": prompt, "stream": False, "think": False,
                "options": {"temperature": 0, "num_predict": max_tokens}}
        url, headers = f"{OLLAMA}/api/generate", {}
    else:
        # provider.zdr: route only to Zero Data Retention endpoints (prompts never stored)
        body = {"model": OR_MODEL, "messages": [{"role": "user", "content": prompt}],
                "temperature": 0, "max_tokens": max_tokens, "reasoning": {"enabled": False},
                "provider": {"zdr": True}}
        url, headers = OPENROUTER, {"Authorization": f"Bearer {arg}"}
    req = urllib.request.Request(url, data=json.dumps(body).encode(),
                                 headers={"Content-Type": "application/json", **headers})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        reply = json.loads(r.read())
    if backend == "ollama":
        return reply.get("response", "")
    return reply["choices"][0]["message"].get("content") or ""


def _tg_ask(title, about=None):
    global _tg_model
    if _tg_model is None:
        _tg_model = _tg_backend()
    # A telegram may run to two lock-screen lines; too long still → once more, harder
    for limit in ("15 words and under 85 characters", "7 words and under 40 characters"):
        prompt = (TG_ABOUT.format(about) if about else "") + TG_PROMPT.format(limit) + title
        reply = _tg_generate(prompt, 40, 20)
        line = reply.strip().splitlines()[0] if reply.strip() else ""
        line = re.sub(r"\s+", " ", re.sub(r"[\"“”]", "", line)).strip(" .").upper()
        if 0 < len(line) <= 2 * NEWS_WIDTH:
            return line
    raise ValueError("unusable reply")


def _tg_store(key, value):
    global _tg_memo
    _tg_memo[key] = value
    while len(_tg_memo) > TG_KEEP:
        _tg_memo.pop(next(iter(_tg_memo)))
    tmp = TG_CACHE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(_tg_memo, f, ensure_ascii=False)
    os.chmod(tmp, 0o644)
    os.replace(tmp, TG_CACHE)
    return value


def telegraph(title, about=None):
    """One terse line for a headline, or "" when it must be shown raw. With `about`, the
    line is written for a row that already carries that topic label, so the name is
    left out of the telegram (memoized under its own key)."""
    global _tg_memo, _tg_down
    if _tg_memo is None:
        try:
            with open(TG_CACHE) as f:
                _tg_memo = dict(json.load(f))
        except (OSError, ValueError):
            _tg_memo = {}
    key = (f"@{about.strip().lower()}|" if about else "") + title.strip().lower()
    key = key[:160]
    if not title.strip() or key in _tg_memo:
        return _tg_memo.get(key, "")
    if _tg_down:
        return ""
    try:
        return _tg_store(key, _tg_ask(title, about))
    except (TimeoutError, OSError):   # Ollama down or stuck: one attempt per run, no memo
        _tg_down = True
        return ""
    except Exception:                 # unusable reply for THIS title: remember, show raw forever
        return _tg_store(key, "")


