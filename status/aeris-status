    }
    top = (st.get("world") or {}).get("outage_top") or []
    for i in range(3):
        code, name = top[i] if i < len(top) else ("", "")
        v[f"internet.{i + 1}k"], v[f"internet.{i + 1}v"] = code, name
    # Watchlist feed: the rows main() already published into status.json watch.rows
