        if str(space.get(key, "")).startswith("NOW"):
            out.append(f"space.{key}")
    g = re.search(r"G(\d)", str(space.get("scales", "")))
    if g and int(g.group(1)) >= 1:
        out.append("space.scales")
    country = str(net.get("city", "")).split(", ")[-1]
    if country and country in (world.get("outage_codes") or []):
        out.append("world.outages")
    return out


def main():
    status = {"updated": time.strftime("%H:%M")}
    net = network_info()
    lat, lon = net.get("lat"), net.get("lon")
    located = lat is not None and lon is not None
    sources = {
        "identity": identity, "state": live_state, "security": security,
        "air": (lambda: airspace(lat, lon)) if located else dict,
        "space": (lambda: orbit(lat, lon)) if located else dict,
        "world": world, "local": local, "iran": iran, "watch": watchlist,
    }
    # In parallel: the nine news feeds alone can take several seconds
    with ThreadPoolExecutor(len(sources)) as pool:
        futures = {name: pool.submit(fn) for name, fn in sources.items()}
    status["net"] = {**net, "fresh": fresh(net)}
    for name, fut in futures.items():
        try:
            status[name] = fut.result()
        except Exception as e:  # one broken source must not blank the rest
            status[name] = {"error": str(e)}
    status["alerts"] = alerts(status)
    # Shared feed rows: the same formatted lines the lock screen shows, published into
    # status.json so the login screen renders an identical watchlist and world feed
    if isinstance(status.get("watch"), dict):
        status["watch"]["rows"] = watch_feed(status)
        checked = max((i.get("checked") or "" for i in status["watch"].get("items") or []), default="")
        status["watch"]["fresh"] = checked[-5:] if checked else NA
    if isinstance(status.get("world"), dict) and not status["world"].get("error"):
        status["world"]["telegrams"] = telegram_feed(status)
    os.makedirs(OUT_DIR, exist_ok=True)
    tmp = OUT + ".tmp"
    with open(tmp, "w") as f:
        json.dump(status, f, ensure_ascii=False, indent=1)
    os.chmod(tmp, 0o644)
    os.replace(tmp, OUT)
    write_lock_view(status)
    write_private()


if __name__ == "__main__":
    main()
