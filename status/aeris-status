# ---------- lock screen view ----------
# hyprlock labels can only run commands, so the lock screen reads pre-formatted lines from
# lock.tsv with awk instead of parsing JSON. Same data as status.json, minus NETWORK and
# SECURITY (the lock screen shows where the laptop is left unattended). Keys are the ones
# lock/make-hyprlock lays out.

NEWS_ROWS = 5    # lock screen news lines, below the watchlist (18 apart)
WATCH_ROWS = 16  # lock screen watchlist lines between the wordmark and WORLD
FEED_WIDTH = 112  # lock screen feed lines use the whole left column, unlike the login's 44
WATCH_DAYS = 7   # the lock screen shows this much watchlist history, acknowledged or not


def cut(text, width):
    return text if len(text) <= width else text[:width - 1].rstrip() + "…"


def _sig_words(title, topic=""):
    """A title's significant words (4+ letters/digits), minus the topic's own name, for
    spotting the same story told by different outlets."""
    drop = set(re.findall(r"[A-Z0-9ÄÖÜ]{3,}", topic.upper().replace("-", " ")))
    return {w for w in re.findall(r"[A-Z0-9ÄÖÜ]{4,}", title.upper())} - drop


def _strip_topic(line, name):
    """Drop a leading topic name the model still repeated: "X: ..." vanishes, "X'S ..."
    becomes "ITS ..."."""
    pat = re.escape(name.upper()).replace(r"\-", r"[-\s]")
    swapped = re.sub(rf"^(THE\s+)?{pat}(['’]S)\s+", "ITS ", line)
    if swapped != line:
        return swapped
    return re.sub(rf"^(THE\s+)?{pat}\s*[:·,—–-]*\s+", "", line) or line


def watch_feed(st):
    """The week's findings across every topic, newest first, one cut row per finding;
    * marks unacknowledged findings, as in watch.html. Shared by the lock screen
    (lock.tsv watch.*) and the login screen (status.json watch.rows). Near-duplicate
    stories (different outlets, same words) collapse into the newest one, and the
    telegram leaves out the topic's name since the row already carries it."""
    wl = (st.get("watch") or {}).get("items") or []
    finds = sorted(((_watch_when(f), i["name"], f) for i in wl for f in i.get("recent") or []),
                   key=lambda x: x[0], reverse=True)
    wrows, seen = [], []   # seen: (word set, row index) per kept finding
    for when, name, f in finds:
        if len(wrows) >= WATCH_ROWS:
            break
        title = re.sub(r"\s+-\s+[^-]{2,40}$", "", f.get("title", ""))  # drop the trailing outlet
        title = re.sub(r"^\[[a-z]{2}(-[A-Za-z]{2})?\]\s*", "", title)  # and the [de-DE] language tag
        sig = _sig_words(title, name)
        dupe = next((idx for s, idx in seen
                     if sig and s and len(sig & s) >= 3 and len(sig & s) >= 0.6 * min(len(sig), len(s))),
                    None)
        if dupe is not None:
            if f.get("new") and wrows[dupe].startswith("·"):  # an unseen copy keeps the star
                wrows[dupe] = "*" + wrows[dupe][1:]
            continue
        tg = _strip_topic(telegraph(title, about=name) or title.upper(), name)
        mark = "*" if f.get("new") else "·"
        day = time.strftime("%d %b", time.localtime(when)).upper()
        seen.append((sig, len(wrows)))
        wrows.append(f"{mark} " + cut(f"{day} · {name.upper()} · {tg}", FEED_WIDTH))
    return wrows or [f"ALL QUIET · {len(wl)} TOPICS · {WATCH_DAYS}D"]


def telegram_feed(st, most=8):
    """World news as bulleted telegrams: one line list per story (first line bulleted,
    continuations indented), built until `most` rows are spoken for. Each screen then
    takes the whole stories that fit its own row count."""
    stories, used = [], 0
    for item in (st.get("world") or {}).get("items") or []:
        tg = telegraph(item.get("title", ""))
        lines = wrap(tg or item.get("title", "").upper(), FEED_WIDTH, 2)
        lines = ["· " + lines[0]] + ["  " + l for l in lines[1:]]
        if used + len(lines) > most:
            break
        stories.append(lines)
        used += len(lines)
    return stories


def lock_view(st):
