# aeris-watch gathers findings on its own hourly timer into watchlist.json; this only
# copies the display fields into status.json. No network calls happen here.
WATCHLIST = f"/home/{USER}/.local/share/aeris/watchlist.json"  # the service runs as root


def _watch_when(f):
    raw = re.sub(r"\s*\[.*?\]\s*$", "", str(f.get("date") or ""))
    try:
        return email.utils.parsedate_to_datetime(raw).timestamp()
    except Exception:
        try:
            return datetime.fromisoformat(raw).timestamp()
        except ValueError:
            return time.time()  # undated: treat as fresh


def watchlist():
    with open(WATCHLIST) as f:
        data = json.load(f)
    items, cutoff = [], time.time() - WATCH_DAYS * 86400
    for i in data.get("items") or []:
        new = i.get("new") or []
        # This week's findings, acknowledged (archive) or not (new), newest first
        recent = [{"title": f.get("title", ""), "date": f.get("date", ""), "new": True} for f in new]
        ids = {f.get("id") for f in new}
        recent += [{"title": f.get("title", ""), "date": f.get("date", ""), "new": False}
                   for f in i.get("archive") or []
                   if f.get("id") not in ids and _watch_when(f) >= cutoff]
        recent.sort(key=_watch_when, reverse=True)
        items.append({"name": i.get("name", ""), "type": i.get("type", ""),
                      "checked": i.get("last_checked", ""), "error": bool(i.get("error")),
                      "new": [{"title": n.get("title", ""), "date": n.get("date", "")} for n in new],
                      "recent": recent[:6]})
    return {"items": items}


