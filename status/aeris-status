def ping_ms(host="1.1.1.1"):
    m = re.search(r"time=([\d.]+) ms", run("ping", "-n", "-c", "1", "-W", "1", host, timeout=3))
    return f"{round(float(m.group(1)))} MS" if m else NA


def dns_ms(server="1.1.1.1", name="example.com"):
    """One A query straight to the resolver, timed (the local cache would answer in 0 ms)."""
    qid = random.randrange(65536)
    query = qid.to_bytes(2, "big") + b"\x01\x00\x00\x01\x00\x00\x00\x00\x00\x00"
    query += b"".join(bytes([len(p)]) + p.encode() for p in name.split(".")) + b"\x00\x00\x01\x00\x01"
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
            sock.settimeout(1)
            start = time.monotonic()
            sock.sendto(query, (server, 53))
            reply = sock.recv(512)
            if reply[:2] != query[:2]:
                return NA
            return f"{round((time.monotonic() - start) * 1000)} MS"
    except OSError:
        return NA


def local():
    z = time.strftime("%z")
    return {"utc": f"{z[:3]}:{z[3:]}" if z else NA, "ping": ping_ms(), "dns": dns_ms()}


