def feed_headlines():
    """The newest distinct defence, intelligence and cyber stories across RSS_FEEDS."""
    stories = []
    for url, label, specialist in RSS_FEEDS:
        try:
            root = ElementTree.fromstring(fetch(url, timeout=8))
        except Exception:
            continue
        for it in root.iter("item"):
            title, date = it.findtext("title"), it.findtext("pubDate")
            if not (title and date):
                continue
            title = clean_title(title.strip())
            if NOISE.search(title) or not (specialist or RELEVANT.search(title)):
                continue
            stories.append((email.utils.parsedate_to_datetime(date), title, label))
    if not stories:
        raise ValueError("no feeds")
    items, seen_words, per_source = [], [], {}
    for when, title, label in sorted(stories, key=lambda s: s[0], reverse=True):
        w = words(title)
        if not w or per_source.get(label, 0) >= PER_SOURCE \
                or any(len(w & s) / min(len(w), len(s)) >= 0.5 for s in seen_words):
            continue
        seen_words.append(w)
        per_source[label] = per_source.get(label, 0) + 1
        items.append({"title": title, "lines": wrap(title),
                      "source": f'{label} · {when.astimezone().strftime("%H:%M")}'})
        if len(items) == NEWS_ITEMS:
            break
    return {"items": items, "via": "RSS"}


