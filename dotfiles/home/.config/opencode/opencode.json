{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "AERIS",
  "model": "ollama/gemma4-e4b-32k",
  "small_model": "openrouter/z-ai/glm-5.3-flash",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.5-35b-32k": {
          "name": "Qwen3.5 35B-A3B (32k, GPU+RAM)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "qwen3.5-9b-16k": {
          "name": "Qwen3.5 9B (16k, GPU only)",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "gemma4-e4b-16k": {
          "name": "Gemma 4 E4B (16k, GPU only)",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "gemma4-e4b-32k": {
          "name": "Gemma 4 E4B (32k, GPU only)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    },
    "openrouter": {
      "models": {
        "z-ai/glm-5.3-flash": {
          "name": "GLM-5.3 Flash (OpenRouter)",
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        }
      }
    }
  },
  "autoupdate": false,
  "websearch": {
    "provider": "tinyfish"
  },
  "agent": {
    "AERIS": {
      "description": "AERIS Agent on GLM-5.3 Flash Free (OpenCode, no key): the default",
      "mode": "primary",
      "model": "opencode/glm-5.3-flash-free",
      "temperature": 0.4,
      "color": "#ffffff",
      "prompt": "{file:./prompts/AERIS.md}",
      "permission": {
        "edit": "allow",
        "webfetch": "allow",
        "external_directory": "ask",
        "bash": {
          "*": "ask",
          "ls*": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "pwd": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "sudo *": "deny",
          "/home/h/.local/bin/aeris-watch *": "allow",
          "/home/h/.local/bin/aeris-onto *": "allow",
          "/home/h/.local/bin/aeris-onto apply *": "ask",
          "/home/h/.local/bin/aeris-onto revert *": "ask",
          "/home/h/.local/bin/aeris-onto reject *": "ask"
        }
      }
    },
    "AERIS-FAST": {
      "description": "AERIS Agent on Gemma 4 E4B (local, GPU only): fastest, lighter reasoning",
      "mode": "primary",
      "model": "ollama/gemma4-e4b-32k",
      "temperature": 0.4,
      "color": "#b0b0b0",
      "prompt": "{file:./prompts/AERIS.md}",
      "permission": {
        "edit": "allow",
        "webfetch": "allow",
        "external_directory": "ask",
        "bash": {
          "*": "ask",
          "ls*": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "pwd": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "sudo *": "deny",
          "/home/h/.local/bin/aeris-watch *": "allow",
          "/home/h/.local/bin/aeris-onto *": "allow",
          "/home/h/.local/bin/aeris-onto apply *": "ask",
          "/home/h/.local/bin/aeris-onto revert *": "ask",
          "/home/h/.local/bin/aeris-onto reject *": "ask"
        }
      }
    },
    "AERIS-CLOUD": {
      "description": "AERIS Agent on GLM-5.3 Flash via OpenRouter: fast, 1M context, leaves the machine",
      "mode": "primary",
      "model": "openrouter/z-ai/glm-5.3-flash",
      "temperature": 0.4,
      "color": "#7a7a7a",
      "prompt": "{file:./prompts/AERIS.md}",
      "permission": {
        "edit": "allow",
        "webfetch": "allow",
        "external_directory": "ask",
        "bash": {
          "*": "ask",
          "ls*": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "pwd": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "sudo *": "deny",
          "/home/h/.local/bin/aeris-watch *": "allow",
          "/home/h/.local/bin/aeris-onto *": "allow",
          "/home/h/.local/bin/aeris-onto apply *": "ask",
          "/home/h/.local/bin/aeris-onto revert *": "ask",
          "/home/h/.local/bin/aeris-onto reject *": "ask"
        }
      }
    }
  }
}
