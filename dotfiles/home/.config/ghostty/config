# AERIS starter config — keep parity with kitty setup
# Match kitty's TERM override: avoids breakage on older SSH hosts and
# programs that don't know xterm-ghostty yet.
term = xterm-256color

# Sane defaults
# AERIS monochrome theme (own file, mirrors the OpenCode AERIS theme)
theme = Aeris
window-padding-x = 8
window-padding-y = 4
cursor-style = bar
copy-on-select = clipboard
# 100 MB, for long log sessions. NOTE: ghostty takes no inline comments
# after a value, so keep remark lines like this one on their own line.
scrollback-limit = 100000000
mouse-scroll-multiplier = 3
# Right-click (trackpad two-finger tap or mouse) pastes the clipboard
right-click-action = paste
confirm-close-surface = false

# Font: matched to kitty (Söhne Mono 9)
font-family = Söhne Mono
font-size = 9

# Wayland: let Hyprland handle decorations
gtk-titlebar = false

# Qt-style clipboard + tabs
# performable: only swallows ctrl+c when a selection exists; otherwise it
# still reaches the shell as SIGINT.
keybind = performable:ctrl+c=copy_to_clipboard
# performable: with no text in the clipboard (e.g. a screenshot) the key passes
# through to the app, so Claude Code can read the image itself (as the old kitty
# smart_paste kitten did)
keybind = performable:ctrl+v=paste_from_clipboard
keybind = ctrl+t=new_tab
keybind = ctrl+w=close_tab
