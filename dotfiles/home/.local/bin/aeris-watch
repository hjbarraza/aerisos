#!/usr/bin/env python3
"""AERIS watchlist: standing collection requirements, checked on a timer.

Item types (all keyless, passive sources):
  topic   news mentions, via Google News RSS search; one item can hold several feeds
          (query + language/region), e.g. the same requirement in English and Polish
  domain  new TLS certificates (crt.sh certificate transparency) and A/AAAA record changes
  url     changes to a page's visible text

Usage:
  aeris-watch list [--feeds] [--json]
  aeris-watch add [topic|domain|url] QUERY [--name NAME] [--note TEXT] [--lang es-MX]
                                     (type defaults to topic; --lang defaults to en-US)
  aeris-watch add-feed NAME QUERY [--lang pl-PL]   add another query/language to a topic item
  aeris-watch drop-feed NAME INDEX                 remove a feed (see: list --feeds)
  aeris-watch note NAME TEXT                       replace an item's note
  aeris-watch remove NAME
  aeris-watch check [NAME]           collect now (the timer runs this a few times a day)
  aeris-watch report [NAME]          new findings not yet acknowledged
  aeris-watch log [NAME]             ALL findings per item: unacknowledged, then archive
  aeris-watch ack NAME|--all         mark findings as reviewed (moves them to the archive; nothing is deleted)

Every state change also rewrites ~/.local/share/aeris/watch.html — a readable page
listing each item's note and full article history with links.

The first check of a new item (or after a feed change) only records a baseline; later checks
report what is new.

Topic queries: keep them short and use OR, quotes and parentheses, e.g.
  (SEDENA OR SEMAR OR "Guardia Nacional") (ciberseguridad OR hackeo)
Every bare word must match, so long lists of words return almost nothing. Use the target's own
language and region for non-English subjects (es-MX, pl-PL, lt-LT, uk-UA, ru-RU, fi-FI, ...).
"""
import argparse
import email.utils
import fcntl
import hashlib
import html
import json
import os
import re
import socket
import sys
import time
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET
from contextlib import contextmanager

DATA_DIR = os.path.expanduser("~/.local/share/aeris")
DATA = os.path.join(DATA_DIR, "watchlist.json")
LOCK = os.path.join(DATA_DIR, "watchlist.lock")
UA = "Mozilla/5.0 (X11; Linux x86_64) AERIS-watch/1.0"
TYPES = ("topic", "domain", "url")
MAX_SEEN = 500
MAX_NEW = 25


@contextmanager
def locked():
    os.makedirs(DATA_DIR, exist_ok=True)
    with open(LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        data = load()
        yield data
        save(data)


def load():
    try:
        with open(DATA) as f:
            return json.load(f)
    except FileNotFoundError:
        return {"items": []}


HISTORY_FILE = os.path.join(DATA_DIR, "watch.html")


def save(data):
    tmp = DATA + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=1, ensure_ascii=False)
    os.replace(tmp, DATA)
    try:
        write_html(data)
    except Exception:
        pass  # the reader page never blocks state changes


def wescape(text):
    return html.escape(str(text or ""), quote=True)


def wdate(raw):
    """'Thu, 26 Feb 2026 08:00:00 GMT' or ISO -> '26 FEB 2026'; unparseable shown raw."""
    raw = re.sub(r"\s*\[.*?\]\s*$", "", str(raw or ""))
    try:
        t = email.utils.parsedate_to_datetime(raw)
    except Exception:
        t = None
    if t is None:
        try:
            from datetime import datetime
            t = datetime.fromisoformat(raw)
        except ValueError:
            return (raw or "—").upper()
    return t.strftime("%d %b %Y").upper()


# ---------- English gloss for foreign-language findings, via the local Ollama ----------
# Memoized on disk like aeris-status's telegram cache: the model is asked once per title,
# and only for findings inside the feed window. If Ollama is down the gloss is simply absent.
GLOSS_CACHE = os.path.join(DATA_DIR, "gloss-cache.json")
GLOSS_KEEP = 600
OLLAMA = "http://127.0.0.1:11434"
GLOSS_MODELS = ("qwen3.5:9b", "qwen3.5-9b-16k:latest", "gemma4:12b")

_gloss_memo = None
_gloss_down = False
_gloss_model = None


def _gloss_ask(title):
    global _gloss_model
    if _gloss_model is None:
        with urllib.request.urlopen(f"{OLLAMA}/api/tags", timeout=3) as r:
            tags = [m.get("name", "") for m in json.loads(r.read()).get("models", [])]
        _gloss_model = next((m for m in GLOSS_MODELS if m in tags), tags[0] if tags else "")
    if not _gloss_model:
        raise ValueError("no ollama model")
    prompt = ("Translate this news headline into plain English: one line, keep names and "
              "numbers, no quotes, no commentary.\n\nHEADLINE: " + title)
    body = json.dumps({"model": _gloss_model, "prompt": prompt, "stream": False,
                       "think": False, "options": {"temperature": 0, "num_predict": 60}}).encode()
    req = urllib.request.Request(f"{OLLAMA}/api/generate", data=body,
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=25) as r:
        reply = json.loads(r.read()).get("response", "")
    line = reply.strip().splitlines()[0].strip(' ".') if reply.strip() else ""
    if not 0 < len(line) <= 200:
        raise ValueError("unusable reply")
    return line


def gloss(title):
    """English rendering of a non-English headline, or "" (never blocks the page)."""
    global _gloss_memo, _gloss_down
    if _gloss_memo is None:
        try:
            with open(GLOSS_CACHE) as f:
                _gloss_memo = dict(json.load(f))
        except (OSError, ValueError):
            _gloss_memo = {}
    key = title.strip().lower()[:160]
    if not key or key in _gloss_memo:
        return _gloss_memo.get(key, "")
    if _gloss_down:
        return ""
    try:
        value = _gloss_ask(title)
    except (TimeoutError, OSError):   # Ollama down or stuck: one attempt per run, no memo
        _gloss_down = True
        return ""
    except Exception:                 # unusable reply for THIS title: remember, show raw
        value = ""
    _gloss_memo[key] = value
    while len(_gloss_memo) > GLOSS_KEEP:
        _gloss_memo.pop(next(iter(_gloss_memo)))
    try:
        tmp = GLOSS_CACHE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(_gloss_memo, f, ensure_ascii=False)
        os.replace(tmp, GLOSS_CACHE)
    except OSError:
        pass
    return value


def wtitle(a, pending, want_gloss=False, extra=0):
    """A finding's title cell: headline (linked, opens a new tab), outlet as a muted
    tail (with +N when near-duplicates were folded into this row), and an English
    gloss under non-English headlines."""
    raw = str(a.get("title") or "")
    m = re.match(r"^\[([A-Za-z]{2})(?:-[A-Za-z]{2})?\]\s*(.*)", raw)
    lang, raw = (m.group(1).lower(), m.group(2)) if m else ("en", raw)
    m = re.search(r"\s+-\s+([^-]{2,40})$", raw)   # trailing "- Outlet"
    raw, src = (raw[:m.start()], m.group(1)) if m else (raw, "")
    text = wescape(raw)
    link = a.get("link") or ""
    if link.startswith("http"):
        text = f'<a href="{wescape(link)}" target=_blank rel=noopener>{text}</a>'
    cell = f'<span class={"live" if pending else "seen"}>{text}</span>'
    if src or extra:
        tail = wescape(src).upper() + (f" +{extra}" if extra else "")
        cell += f' <span class="src mono">{tail.strip()}</span>'
    if want_gloss and lang != "en":
        g = gloss(raw)
        if g:
            cell += f"<div class=gloss>EN &middot; {wescape(g)}</div>"
    return cell


def wsig(title, topic):
    """A title's significant words minus the topic's own name, for spotting the same
    story told by different outlets (as the lock screen feed does)."""
    drop = set(re.findall(r"[A-Z0-9ÄÖÜ]{3,}", topic.upper().replace("-", " ")))
    t = re.sub(r"^\[[A-Za-z-]+\]\s*", "", str(title or ""))
    t = re.sub(r"\s+-\s+[^-]{2,40}$", "", t)
    return {w for w in re.findall(r"[A-Z0-9ÄÖÜ]{4,}", t.upper())} - drop


def wfoldsig(title, topic):
    """Fold words for a finding: a non-English title compares through its English
    gloss (already memoized for display), so the same story folds across languages.
    Returns (words, glossed) — glossed pairs get a looser match, translations being
    paraphrases rather than copies."""
    m = re.match(r"^\[([A-Za-z]{2})(?:-[A-Za-z]{2})?\]\s*(.*)", str(title or ""))
    if m and m.group(1).lower() != "en":
        body = re.sub(r"\s+-\s+[^-]{2,40}$", "", m.group(2))
        g = gloss(body)
        if g:
            return wsig(g, topic), True
    return wsig(title, topic), False


def wwhen(f):
    """A finding's timestamp for feed order; undated sorts last."""
    raw = re.sub(r"\s*\[.*?\]\s*$", "", str(f.get("date") or ""))
    try:
        return email.utils.parsedate_to_datetime(raw).timestamp()
    except Exception:
        try:
            from datetime import datetime
            return datetime.fromisoformat(raw).timestamp()
        except ValueError:
            return 0.0


FEED_DAYS = 30  # the page shows this window; everything older is one EARLIER line


def write_html(data):
    """One chronological feed of every finding across all topics (a news feed, newest
    day first, last FEED_DAYS days), set like the AERIS screens: black, greyscale,
    Söhne / Söhne Mono. Topic chips filter the feed; non-English headlines carry an
    English gloss from the local Ollama."""
    new_total = sum(len(i.get("new") or []) for i in data["items"])
    out = ['<!doctype html><html lang=en><head><meta charset=utf-8>'
           '<meta name=viewport content="width=device-width, initial-scale=1">'
           "<title>AERIS WATCH</title><style>"
           ":root{--fg:#e6e6e6;--grey:#7a7a7a;--dim:#3a3a3a;--hair:#1c1c1c;color-scheme:dark}"
           "*{margin:0;box-sizing:border-box}::selection{background:#fff;color:#000}"
           'body{background:#000;color:var(--fg);font:14px/1.5 "Söhne",system-ui,sans-serif;'
           "max-width:1080px;margin:56px auto 112px;padding:0 40px}"
           '.mono{font-family:"Söhne Mono",monospace}'
           ".top{display:flex;justify-content:space-between;font-size:11px;letter-spacing:2px;color:var(--grey)}"
           ".top b{color:#fff;font-weight:normal}"
           "h1{font-size:46px;font-weight:400;letter-spacing:-1px;color:#fff;margin:34px 0 10px}"
           ".tagline{font-size:11px;letter-spacing:2px;color:#fff;margin-bottom:14px}"
           ".tagline span{color:var(--grey)}"
           "hr{border:0;border-top:1px solid #fff;margin:0 0 8px}"
           ".topics{display:flex;flex-wrap:wrap;gap:6px 26px;margin:22px 0 0;"
           "font-size:11px;letter-spacing:1px;color:var(--grey)}"
           ".topics b{color:#fff;font-weight:normal}"
           ".topics span{cursor:pointer;user-select:none}"
           ".topics span:hover{color:#fff}"
           ".topics .sel{background:#fff;color:#000;padding:0 6px}.topics .sel b{color:#000}"
           ".topics .err{background:#fff;color:#000;padding:0 6px}"
           "section{margin-top:44px}"
           ".head{display:flex;align-items:baseline;font-size:11px;letter-spacing:2px}"
           ".head .sl{color:#fff;font-size:13px;letter-spacing:0}"
           ".head .nm{color:#fff;margin-left:9px}"
           ".head .meta{margin-left:auto;color:var(--grey);letter-spacing:1px}"
           "table{width:100%;border-collapse:collapse;margin-top:12px}"
           "td{border-top:1px solid var(--hair);padding:6px 0;vertical-align:baseline}"
           "td.m{width:24px;color:#fff}td.m.dot{color:var(--dim)}"
           "td.k{width:138px;font-size:11px;letter-spacing:1px;color:var(--grey);"
           "white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding-right:14px}"
           "td.t{padding-left:4px}"
           ".live{color:#fff}.seen{color:#8f8f8f}"
           ".src{color:var(--dim);font-size:11px;letter-spacing:1px;margin-left:8px;white-space:nowrap}"
           ".gloss{color:var(--grey);font-size:12px;margin-top:1px}"
           # a repeated topic label is hidden, ledger-style, unless the feed is filtered
           "body:not(.filtered) tr.rep td.k{visibility:hidden}"
           "a{color:inherit;text-decoration:none}"
           "a:hover{color:#fff;text-decoration:underline;text-underline-offset:3px}"
           "</style></head><body>"]
    out.append('<div class="top mono"><span>SYS/00 &middot; <b>WATCHLIST</b></span>'
               f"<span>REGENERATED {wescape(time.strftime('%a %d %b %Y   %H:%M').upper())}</span></div>")
    out.append("<h1>WATCHLIST</h1>")
    out.append(f'<div class="tagline mono">AERIS STANDING COLLECTION REQUIREMENTS <span>&middot; '
               f"{len(data['items'])} ITEMS &middot; {new_total} UNACKNOWLEDGED (&#9733;)"
               f" &middot; LAST {FEED_DAYS} DAYS &middot; CLICK A TOPIC TO FILTER</span></div>")
    out.append("<hr>")
    # Topic chips: click to filter the feed; note on hover; collection errors inverted
    out.append('<div class="topics mono">')
    if new_total:
        out.append(f'<span data-f="*new">NEW <b>{new_total}&#9733;</b></span>')
    for i in data["items"]:
        n = len(i.get("new") or [])
        cls = " err" if i.get("error") else ""
        out.append(f'<span class="t{cls}" data-f="{wescape(i["name"])}" '
                   f'title="{wescape(i.get("note") or i.get("error") or "")}">'
                   f'{wescape(i["name"]).upper()}{f" <b>{n}&#9733;</b>" if n else ""}</span>')
    out.append("</div>")
    # One flat feed, newest first, grouped by day; a finding carries its topic
    rows_all = []
    for i in data["items"]:
        pend = i.get("new", []) or []
        ids = {a.get("id") for a in pend}
        for a in pend:
            rows_all.append((wwhen(a), i["name"], a, True))
        for a in i.get("archive", []) or []:
            if a.get("id") not in ids:
                rows_all.append((wwhen(a), i["name"], a, False))
    rows_all.sort(key=lambda r: r[0], reverse=True)
    cutoff = time.time() - FEED_DAYS * 86400
    recent = [r for r in rows_all if r[0] >= cutoff]
    # Near-duplicates (same story, different outlets or languages) fold into the newest
    # row, which stays starred while any folded copy is unacknowledged
    kept = []
    for ts, name, a, pending in recent:
        sig, glossed = wfoldsig(a.get("title"), name)
        dup = next((k for k in kept if sig and k["sig"] and len(sig & k["sig"]) >= 3
                    and len(sig & k["sig"]) >=
                    (0.5 if glossed or k["glossed"] else 0.6) * min(len(sig), len(k["sig"]))),
                   None)
        if dup is not None:
            dup["extra"] += 1
            dup["pending"] = dup["pending"] or pending
        else:
            kept.append({"sig": sig, "glossed": glossed, "ts": ts, "name": name, "a": a,
                         "pending": pending, "extra": 0})
    days = {}   # insertion order = feed order
    for k in kept:
        label = time.strftime("%a %d %b %Y", time.localtime(k["ts"])).upper()
        days.setdefault(label, []).append(k)
    for label, rows in days.items():
        # Feed dates carry no real time of day, so unacknowledged findings lead the day
        rows.sort(key=lambda k: not k["pending"])
        stars = sum(1 for k in rows if k["pending"])
        folded = sum(k["extra"] for k in rows)
        out.append('<section><div class="head mono"><span class=sl>//</span>'
                   f"<span class=nm>{wescape(label)}</span>"
                   f"<span class=meta>{len(rows)} FINDINGS"
                   + (f" &middot; {stars} NEW" if stars else "")
                   + (f" &middot; {folded} FOLDED" if folded else "") + "</span></div><table>")
        last = None
        for k in rows:
            name, pending = k["name"], k["pending"]
            out.append('<tr class="%s" data-t="%s" data-n="%d">'
                       '<td class="m mono%s">%s</td><td class="k mono">%s</td><td class=t>%s</td></tr>'
                       % ("rep" if name == last else "", wescape(name), int(pending),
                          "" if pending else " dot", "&#9733;" if pending else "&middot;",
                          wescape(name).upper(),
                          wtitle(k["a"], pending, want_gloss=True, extra=k["extra"])))
            last = name
        out.append("</table></section>")
    if len(recent) < len(rows_all):
        out.append('<section><div class="head mono"><span class=sl>//</span><span class=nm>EARLIER</span>'
                   f"<span class=meta>{len(rows_all) - len(recent)} OLDER FINDINGS &middot; "
                   "AERIS-WATCH LOG</span></div></section>")
    # Topic chips filter the feed; clicking the active chip clears it
    out.append("""<script>
const chips = document.querySelectorAll('.topics span[data-f]')
chips.forEach(ch => ch.onclick = () => {
  const on = !ch.classList.contains('sel')
  chips.forEach(o => o.classList.remove('sel'))
  if (on) ch.classList.add('sel')
  const f = on ? ch.dataset.f : ''
  document.body.classList.toggle('filtered', !!f)
  document.querySelectorAll('tr[data-t]').forEach(tr => {
    tr.style.display = !f || (f === '*new' ? tr.dataset.n === '1' : tr.dataset.t === f) ? '' : 'none'
  })
  document.querySelectorAll('section').forEach(s => {
    const trs = [...s.querySelectorAll('tr')]
    if (trs.length) s.style.display = trs.some(tr => tr.style.display !== 'none') ? '' : 'none'
  })
})
</script></body></html>""")
    with open(HISTORY_FILE, "w") as f:
        f.write("\n".join(out))
    os.chmod(HISTORY_FILE, 0o644)


def fetch(url, timeout=30):
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=timeout) as res:
        return res.read()


def news_params(lang):
    """Google News locale parameters for a language-REGION code such as es-MX or pl-PL."""
    language, _, region = lang.partition("-")
    region = (region or "US").upper()
    if language == "es" and region != "ES":
        language = "es-419"  # Google News serves Latin American Spanish as es-419
    elif language in ("en", "pt", "zh"):
        language = f"{language}-{region}"
    return f"hl={language}&gl={region}&ceid={region}:{language}"


def feeds(item):
    """Topic feeds; items created before multi-feed support carry a single English query."""
    return item.get("feeds") or [{"query": item["query"], "lang": "en-US"}]


def describe(item):
    if item["type"] != "topic":
        return item["query"]
    return " | ".join(f"[{f['lang']}] {f['query']}" for f in feeds(item))


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")[:40] or "item"


def find(data, name):
    for item in data["items"]:
        if item["name"] == name:
            return item
    sys.exit(f"aeris-watch: no item named {name!r} (see: aeris-watch list)")


# --- collectors: each returns (findings, fingerprint); findings are dicts with id/title/link/date ---

def collect_topic(item):
    findings = []
    for n, feed in enumerate(feeds(item)):
        q = urllib.parse.quote(feed["query"])
        root = ET.fromstring(fetch(f"https://news.google.com/rss/search?q={q}&{news_params(feed['lang'])}"))
        for entry in root.iter("item"):
            title = html.unescape(entry.findtext("title") or "").strip()
            findings.append({
                "id": entry.findtext("guid") or entry.findtext("link") or title,
                "title": f"[{feed['lang']}] {title}",
                "link": entry.findtext("link") or "",
                "date": entry.findtext("pubDate") or "",
                "_feed": n,  # remember the feed so check_item can interleave them fairly
            })
    return findings, None


def domain_certs(domain):
    """New certificates from certificate transparency: CertSpotter first, crt.sh as fallback."""
    try:
        issuances = json.loads(fetch(
            f"https://api.certspotter.com/v1/issuances?domain={urllib.parse.quote(domain)}"
            "&include_subdomains=true&expand=dns_names&expand=issuer", 45))
        return [{
            "id": f"ctsp:{c['id']}",
            "title": f"New certificate: {', '.join(c.get('dns_names', []))[:200]} (issuer: {(c.get('issuer') or {}).get('friendly_name', '?')})",
            "link": f"https://crt.sh/?q={c.get('cert_sha256', '')}",
            "date": c.get("not_before", ""),
        } for c in issuances]
    except Exception:
        certs = json.loads(fetch(f"https://crt.sh/?q={urllib.parse.quote('%.' + domain)}&output=json&exclude=expired", 60) or b"[]")
        return [{
            "id": f"crt:{c.get('id')}",
            "title": f"New certificate: {', '.join(sorted(set(c.get('name_value', '').split(chr(10)))))[:200]} (issuer: {c.get('issuer_name', '?')[:80]})",
            "link": f"https://crt.sh/?id={c.get('id')}",
            "date": c.get("not_before", ""),
        } for c in certs]


def collect_domain(item):
    domain = item["query"].lower().strip().rstrip(".")
    try:
        addrs = sorted({a[4][0] for a in socket.getaddrinfo(domain, None)})
    except socket.gaierror:
        addrs = []
    fingerprint = ",".join(addrs) or "NXDOMAIN"
    try:
        findings = domain_certs(domain)
        item.pop("warning", None)
    except Exception as exc:  # certificate logs down: still track DNS, retry certificates next run
        item["warning"] = f"certificate logs unavailable ({type(exc).__name__})"
        findings = [{"id": i} for i in item.get("seen", [])]
    return findings, fingerprint


def collect_url(item):
    text = fetch(item["query"]).decode("utf-8", "replace")
    text = re.sub(r"(?is)<(script|style|noscript)[^>]*>.*?</\1>", " ", text)
    text = re.sub(r"<[^>]+>", " ", text)
    text = re.sub(r"\s+", " ", html.unescape(text)).strip()
    return [], hashlib.sha256(text.encode()).hexdigest()[:16]


COLLECTORS = {"topic": collect_topic, "domain": collect_domain, "url": collect_url}


def interleaved(findings):
    """Round-robin across feeds so no language crowds another out of the new-list cap."""
    buckets = {}
    for f in findings:
        buckets.setdefault(f.get("_feed", 0), []).append(f)
    out = []
    while any(buckets.values()):
        for key in sorted(buckets):
            if buckets[key]:
                out.append(buckets[key].pop(0))
    return out


def check_item(item):
    now = time.strftime("%Y-%m-%d %H:%M")
    try:
        findings, fingerprint = COLLECTORS[item["type"]](item)
    except Exception as exc:  # network errors etc. are recorded, not fatal
        item["error"] = f"{type(exc).__name__}: {exc}"[:200]
        item["last_checked"] = now
        return 0
    item.pop("error", None)
    baseline = "last_checked" not in item or item.get("baseline_pending", False)
    seen = set(item.get("seen", []))
    fresh = [f for f in findings if f["id"] not in seen]
    if fingerprint is not None and item.get("fingerprint") not in (None, fingerprint) and not baseline:
        label = "DNS records" if item["type"] == "domain" else "Page content"
        fresh.append({"id": f"fp:{fingerprint}:{now}", "title": f"{label} changed: {item['fingerprint']} -> {fingerprint}",
                      "link": item["query"] if item["type"] == "url" else "", "date": now})
    item["seen"] = list(dict.fromkeys([f["id"] for f in findings] + item.get("seen", [])))[:MAX_SEEN]
    if fingerprint is not None:
        item["fingerprint"] = fingerprint
    item["last_checked"] = now
    item.pop("baseline_pending", None)
    if baseline or not fresh:
        return 0
    item["new"] = (fresh + item.get("new", []))[:MAX_NEW]
    item["last_changed"] = now
    return len(fresh)


# --- commands ---

def cmd_list(args):
    data = load()
    if args.json:
        print(json.dumps([{**{k: v for k, v in i.items() if k != "seen"}, **({"feeds": feeds(i)} if i["type"] == "topic" else {})}
                          for i in data["items"]], indent=1, ensure_ascii=False))
        return
    if not data["items"]:
        print("Watchlist is empty. Add one with: aeris-watch add topic|domain|url QUERY")
    for i in data["items"]:
        state = "ERROR" if i.get("error") else (f"CHANGED +{len(i['new'])}" if i.get("new") else "QUIET")
        state += "*" if i.get("warning") else ""
        langs = ",".join(f["lang"] for f in feeds(i)) if i["type"] == "topic" else "-"
        print(f"{i['name']:<28} {i['type']:<7} {state:<12} {langs:<18} checked {i.get('last_checked', 'never'):<17}"
              + (f"  # {i['note']}" if i.get("note") else "") + (f"  ({i['warning']})" if i.get("warning") else ""))
        if args.feeds:
            if i["type"] == "topic":
                for n, f in enumerate(feeds(i)):
                    print(f"    {n}  [{f['lang']}] {f['query']}")
            else:
                print(f"    {i['query']}")


def cmd_add(args):
    # "add topic|domain|url QUERY", or "add QUERY" for a news topic
    args.type, words = (args.words[0], args.words[1:]) if args.words[0] in TYPES and len(args.words) > 1 else ("topic", args.words)
    # a leading slug-like word without --name is the item name, not search text
    if not args.name and len(words) > 1 and re.fullmatch(r"[a-z0-9]+(-[a-z0-9]+)+", words[0]):
        args.name, words = words[0], words[1:]
    args.query = " ".join(words)
    if args.type == "url" and not re.match(r"https?://", args.query):
        sys.exit("aeris-watch: url items need a full http(s):// address")
    with locked() as data:
        name = slug(args.name or args.query)
        if any(i["name"] == name for i in data["items"]):
            sys.exit(f"aeris-watch: {name!r} already exists")
        item = {"name": name, "type": args.type, "note": args.note or "",
                "added": time.strftime("%Y-%m-%d %H:%M"), "baseline_pending": True}
        if args.type == "topic":
            item["feeds"] = [{"query": args.query, "lang": args.lang}]
        else:
            item["query"] = args.query
        data["items"].append(item)
        check_item(item)  # record the baseline now so the next check reports only what is new
    print(f"added {name} ({args.type}: {describe(item)}); baseline recorded" + (f", error: {item['error']}" if item.get("error") else ""))


def cmd_add_feed(args):
    with locked() as data:
        item = find(data, args.name)
        if item["type"] != "topic":
            sys.exit("aeris-watch: only topic items have feeds")
        item["feeds"] = feeds(item) + [{"query": " ".join(args.query), "lang": args.lang}]
        item.pop("query", None)
        item["baseline_pending"] = True  # absorb the new feed's backlog without flagging it
        check_item(item)
    print(f"{args.name}: {describe(item)}")


def cmd_drop_feed(args):
    with locked() as data:
        item = find(data, args.name)
        current = feeds(item)
        if not 0 <= args.index < len(current) or len(current) == 1:
            sys.exit("aeris-watch: bad index, or it is the item's only feed (remove the item instead)")
        del current[args.index]
        item["feeds"] = current
        item.pop("query", None)
    print(f"{args.name}: {describe(item)}")


def cmd_note(args):
    with locked() as data:
        find(data, args.name)["note"] = " ".join(args.text)
    print(f"{args.name}: note updated")


def cmd_remove(args):
    with locked() as data:
        find(data, args.name)
        data["items"] = [i for i in data["items"] if i["name"] != args.name]
    print(f"removed {args.name}")


def cmd_check(args):
    with locked() as data:
        items = [find(data, args.name)] if args.name else data["items"]
        for item in items:
            n = check_item(item)
            status = f"error: {item['error']}" if item.get("error") else (f"{n} new" if n else "no change")
            print(f"{item['name']}: {status}")


def cmd_report(args):
    data = load()
    items = [find(data, args.name)] if args.name else data["items"]
    pending = [i for i in items if i.get("new")]
    if not pending:
        print("No unreviewed watchlist findings.")
    for i in pending:
        print(f"## {i['name']} ({i['type']}: {describe(i)}), {len(i['new'])} new, last change {i.get('last_changed')}")
        if i.get("note"):
            print(f"Note: {i['note']}")
        for f in i["new"]:
            print(f"- {f['title']} | {f['date']} | {f['link']}")
        print()
    print(f"(history + readable page: aeris-watch log [NAME] / {HISTORY_FILE})")


def cmd_ack(args):
    with locked() as data:
        if not args.all and not args.name:
            sys.exit("aeris-watch: ack needs a NAME or --all")
        items = data["items"] if args.all else [find(data, args.name)]
        moved = 0
        for i in items:
            pending = i.get("new", [])
            if pending:
                have = {a["id"] for a in i.get("archive", [])}
                keep = [{k: v for k, v in a.items() if not k.startswith("_")} for a in pending if a["id"] not in have]
                i["archive"] = keep + i.get("archive", [])[:MAX_SEEN]
                moved += len(keep)
            i["new"] = []
    print("acknowledged " + ("all items" if args.all else args.name) + f"; {moved} findings archived")


def cmd_log(args):
    data = load()
    items = [find(data, args.name)] if args.name else data["items"]
    for i in items:
        arch = i.get("archive", [])
        pend = i.get("new", [])
        if not arch and not pend:
            print(f"## {i['name']} (no findings recorded yet)")
            continue
        pending_ids = {a["id"] for a in pend}
        print(f"## {i['name']} ({i['type']}: {describe(i)}), {len(pend)} unacknowledged, {len(arch)} archived")
        if i.get("note"):
            print(f"Note: {i['note']}")
        for f in pend + arch:
            mark = "* " if f["id"] in pending_ids else "  "
            print(f"{mark}{f.get('date', '')} | {f.get('title', f.get('id', '?'))} | {f.get('link', '')}")
        print()
    print(f"(* unacknowledged; readable page: {HISTORY_FILE})")


def main():
    p = argparse.ArgumentParser(prog="aeris-watch", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("list"); s.add_argument("--json", action="store_true"); s.add_argument("--feeds", action="store_true")
    s.set_defaults(fn=cmd_list)
    s = sub.add_parser("add"); s.add_argument("words", nargs="+", metavar="[topic|domain|url] QUERY")
    s.add_argument("--name"); s.add_argument("--note"); s.add_argument("--lang", default="en-US"); s.set_defaults(fn=cmd_add)
    s = sub.add_parser("add-feed"); s.add_argument("name"); s.add_argument("query", nargs="+")
    s.add_argument("--lang", default="en-US"); s.set_defaults(fn=cmd_add_feed)
    s = sub.add_parser("drop-feed"); s.add_argument("name"); s.add_argument("index", type=int); s.set_defaults(fn=cmd_drop_feed)
    s = sub.add_parser("note"); s.add_argument("name"); s.add_argument("text", nargs="+"); s.set_defaults(fn=cmd_note)
    s = sub.add_parser("remove"); s.add_argument("name"); s.set_defaults(fn=cmd_remove)
    s = sub.add_parser("check"); s.add_argument("name", nargs="?"); s.set_defaults(fn=cmd_check)
    s = sub.add_parser("report"); s.add_argument("name", nargs="?"); s.set_defaults(fn=cmd_report)
    s = sub.add_parser("log"); s.add_argument("name", nargs="?"); s.set_defaults(fn=cmd_log)
    s = sub.add_parser("ack"); s.add_argument("name", nargs="?"); s.add_argument("--all", action="store_true")
    s.set_defaults(fn=cmd_ack)
    s = sub.add_parser("html")   # rewrite the reader page without changing state
    s.set_defaults(fn=lambda args: (write_html(load()), print("wrote " + HISTORY_FILE)))
    args = p.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
