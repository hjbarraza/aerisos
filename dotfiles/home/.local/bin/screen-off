#!/bin/bash
# screen-off - lock and turn the screen off, keeping the laptop running.
# Holds a systemd idle+sleep inhibitor while the lock screen is up, so hypridle's
# 30-minute suspend never fires; unlocking releases it and normal idle behaviour
# returns. Any key press turns the screen back on (misc.key_press_enables_dpms).
loginctl lock-session
for _ in $(seq 50); do pidof hyprlock >/dev/null && break; sleep 0.1; done
sleep 0.3    # let hyprlock cover the screen before it goes dark
hyprctl dispatch 'hl.dsp.dpms({action = "off"})'
pidof hyprlock >/dev/null || exit 0   # lock never came up: don't inhibit forever
exec systemd-inhibit --what=idle:sleep --who="Screen off" \
    --why="Screen off, system kept awake until unlock" \
    bash -c 'while pidof hyprlock >/dev/null; do sleep 5; done'
