#!/bin/bash
# nightlight toggle  - warm screen (4000K) on/off via hyprsunset
# nightlight         - Waybar JSON: moon icon while on, hidden otherwise.
if [[ ${1:-} == toggle ]]; then
  if pgrep -x hyprsunset >/dev/null; then pkill -x hyprsunset
  else hyprsunset -t 4000 >/dev/null 2>&1 & disown
  fi
  sleep 0.3; pkill -RTMIN+11 waybar
  exit
fi
pgrep -x hyprsunset >/dev/null \
  && printf '{"text":"","class":"on","tooltip":"Night light is on - click to turn off"}\n' \
  || printf '{"text":""}\n'
