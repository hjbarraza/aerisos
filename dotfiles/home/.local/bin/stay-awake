#!/bin/bash
# Stay Awake: hold a systemd idle/sleep inhibitor (respected by hypridle and logind).
# `stay-awake toggle` flips it; `stay-awake` prints Waybar JSON (hidden when off).
pidfile="${XDG_RUNTIME_DIR:-/tmp}/stay-awake.pid"
running() { [[ -f $pidfile ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null; }

if [[ ${1:-} == toggle ]]; then
  if running; then
    kill "$(cat "$pidfile")"; rm -f "$pidfile"
  else
    systemd-inhibit --what=idle:sleep --who="Stay Awake" --why="Toggled from the bar" sleep infinity &
    echo $! > "$pidfile"
  fi
  pkill -RTMIN+9 waybar
  exit
fi
if running; then
  printf '{"text":"","class":"on","tooltip":"Stay Awake is on - screen won'"'"'t lock or sleep"}\n'
else
  printf '{"text":""}\n'
fi
