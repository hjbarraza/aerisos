#!/usr/bin/env python3
"""The watchlist as an inbox: a numbered list of this week's findings, newest first.

    aeris-inbox          the inbox (last 7 days, * = unacknowledged)
    aeris-inbox N        full detail of row N: title, topic question, date, link
    aeris-inbox --days D widen or narrow the window

Row numbers are deterministic for a given watchlist state (sorted by date then id),
so `aeris-inbox 3` matches row 3 of the listing just printed. Acknowledging or new
findings change the numbering; re-list before drilling in after an ack.
"""
import email.utils
import json
import os
import re
import sys
import time
from datetime import datetime

WATCHLIST = os.path.expanduser("~/.local/share/aeris/watchlist.json")


def when(f):
    raw = re.sub(r"\s*\[.*?\]\s*$", "", str(f.get("date") or ""))
    try:
        return email.utils.parsedate_to_datetime(raw).timestamp()
    except Exception:
        try:
            return datetime.fromisoformat(raw).timestamp()
        except ValueError:
            return time.time()


def clean(title):
    return re.sub(r"^\[[-a-zA-Z]+\]\s*", "", str(title or "")).strip()


def rows(days):
    with open(WATCHLIST) as fh:
        data = json.load(fh)
    cutoff = time.time() - days * 86400
    out = []
    for item in data.get("items") or []:
        new_ids = {f.get("id") for f in item.get("new") or []}
        for f in (item.get("new") or []) + (item.get("archive") or []):
            t = when(f)
            if t >= cutoff:
                out.append((t, f.get("id") or "", item, f, f.get("id") in new_ids))
    seen = set()
    out = [r for r in sorted(out, key=lambda r: (-r[0], r[1])) if not (r[1] in seen or seen.add(r[1]))]
    return out


def main():
    args = sys.argv[1:]
    days = 7
    if "--days" in args:
        i = args.index("--days")
        days = int(args[i + 1])
        del args[i:i + 2]
    found = rows(days)
    if args:  # detail view
        n = int(args[0])
        if not 1 <= n <= len(found):
            sys.exit(f"aeris-inbox: row {n} not in 1..{len(found)}")
        t, _, item, f, unread = found[n - 1]
        print(f"topic:    {item['name']}" + ("   [UNREAD]" if unread else ""))
        print(f"question: {item.get('note', '')}")
        print(f"date:     {time.strftime('%a %d %b %Y %H:%M', time.localtime(t))}")
        print(f"title:    {clean(f.get('title'))}")
        print(f"link:     {f.get('link', '')}")
        return
    unread = sum(1 for r in found if r[4])
    topics = len({r[2]["name"] for r in found})
    print(f"WATCHLIST INBOX · {len(found)} items · {unread} unread · {topics} topics · last {days}d\n")
    for i, (t, _, item, f, is_new) in enumerate(found, 1):
        mark = "*" if is_new else " "
        day = time.strftime("%d %b", time.localtime(t)).upper()
        print(f"{i:>3} {mark} {day}  {item['name'].upper():<16} {clean(f.get('title'))}")


if __name__ == "__main__":
    main()
