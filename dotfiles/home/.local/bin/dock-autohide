#!/bin/bash
# Auto-hide for the AerisOS pill dock (quickshell): show/hide via quickshell IPC.
# Show when the cursor touches the bottom edge (anywhere along it); hide once
# it leaves the pill area. Drives ~/.config/quickshell/aeris-dock/shell.qml.
QSCONF="$HOME/.config/quickshell/aeris-dock/shell.qml"
EDGE=2           # how close to the bottom edge counts as "hit"
XPAD=48          # extra width either side still counts as "on the dock"
YPAD=56          # extra height above the pill still counts as "on the dock"

ipc() { QT_QPA_PLATFORMTHEME=gtk3 qs ipc -p "$QSCONF" call dock "$1" >/dev/null 2>&1; }

start_dock() {
  setsid env QT_QPA_PLATFORMTHEME=gtk3 qs -p "$QSCONF" >/dev/null 2>&1 &
  sleep 1.5
  pid=$(pgrep -nf "qs -p $QSCONF")
  shown=0
}

# Monitor rectangles in logical px: "x0 y0 x1 y1" per line
read_monitors() {
  mapfile -t mons < <(hyprctl monitors -j | python3 -c '
import json,sys
for m in json.load(sys.stdin):
    w=m["width"]/m["scale"]; h=m["height"]/m["scale"]
    print(m["x"], m["y"], int(m["x"]+w), int(m["y"]+h))')
}

pid=$(pgrep -nf "qs -p $QSCONF") || start_dock
read_monitors
tick=0
shown=0
dx=0; dy=0; dw=0; dh=0

while sleep 0.15; do
  kill -0 "$pid" 2>/dev/null || start_dock
  (( ++tick % 30 == 0 )) && read_monitors     # pick up monitor changes every ~5s

  IFS=', ' read -r x y < <(hyprctl cursorpos)
  bottom=""
  for m in "${mons[@]}"; do
    read -r x0 y0 x1 y1 <<<"$m"
    if (( x >= x0 && x < x1 && y >= y0 && y <= y1 )); then bottom=$y1; break; fi
  done
  [[ -z $bottom ]] && continue

  if (( y >= bottom - EDGE )); then
    (( shown )) || { ipc reveal; shown=1; }
    continue
  fi
  (( shown )) || continue

  # Pill geometry while visible: hyprctl layers line "xywh: X Y W H" for our surface
  read -r dx dy dw dh < <(hyprctl layers | grep "namespace: quickshell" | grep -oP 'xywh: \K[0-9-]+ [0-9-]+ [0-9]+ [0-9]+')
  [[ -z $dw ]] && continue

  inside_x=$(( x >= dx - XPAD && x <= dx + dw + XPAD ))
  inside_y=$(( y >= dy - YPAD ))
  if (( ! inside_x || ! inside_y )); then
    ipc conceal; shown=0
  fi
done
