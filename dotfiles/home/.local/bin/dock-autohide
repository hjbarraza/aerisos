#!/bin/bash
# Auto-hide for nwg-dock-hyprland: show when the cursor touches the bottom edge
# (anywhere along it), hide once it leaves the dock area. Replaces the dock's own
# -d hotspot, which could get stuck open and blocked clicks along the bottom.
#
# The dock's right-click menus are popups that Hyprland doesn't list, so the
# dock stays open while the cursor is in the zone above it where menus open.
DOCK_ARGS=(-r -i 36 -mb 8 -nolauncher)
EDGE=2           # how close to the bottom edge counts as "hit"
MENU_H=420       # height above the dock kept open for its popup menus
MENU_PAD=160     # extra width either side (menus can be wider than an icon)

start_dock() { nwg-dock-hyprland "${DOCK_ARGS[@]}" >/dev/null 2>&1 & sleep 1; shown=1; }

# Monitor rectangles in logical px: "x0 y0 x1 y1" per line
read_monitors() {
  mapfile -t mons < <(hyprctl monitors -j | python3 -c '
import json,sys
for m in json.load(sys.stdin):
    w=m["width"]/m["scale"]; h=m["height"]/m["scale"]
    print(m["x"], m["y"], int(m["x"]+w), int(m["y"]+h))')
}

pkill -x nwg-dock-hyprla
start_dock
read_monitors
tick=0
dx=0; dy=0; dw=0; dh=0

while sleep 0.15; do
  pid=$(pgrep -x nwg-dock-hyprla) || { start_dock; continue; }
  (( ++tick % 30 == 0 )) && read_monitors     # pick up monitor changes every ~5s

  IFS=', ' read -r x y < <(hyprctl cursorpos)
  bottom=""
  for m in "${mons[@]}"; do
    read -r x0 y0 x1 y1 <<<"$m"
    if (( x >= x0 && x < x1 && y >= y0 && y <= y1 )); then bottom=$y1; break; fi
  done
  [[ -z $bottom ]] && continue

  if (( y >= bottom - EDGE )); then
    (( shown )) || { kill -36 "$pid"; shown=1; }
    continue
  fi
  (( shown )) || continue

  # Dock geometry while it's visible: "xywh: X Y W H"
  read -r dx dy dw dh < <(hyprctl layers | grep -B0 'namespace: nwg-dock' | grep -oP 'xywh: \K[0-9-]+ [0-9-]+ [0-9]+ [0-9]+')
  [[ -z $dw ]] && continue

  inside_x=$(( x >= dx - MENU_PAD && x <= dx + dw + MENU_PAD ))
  inside_y=$(( y >= dy - MENU_H ))
  if (( ! inside_x || ! inside_y )); then
    kill -37 "$pid"; shown=0
  fi
done
