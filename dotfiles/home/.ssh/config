# One login per host, shared by every ssh/scp/git connection for 30 min after the last one
# closes (Tailscale SSH's browser check is then asked once, not per command). Keepalives stop
# idle sessions dropping behind NAT. Remove a stuck master with: ssh -O exit <host>
Host *
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 30m
    ServerAliveInterval 30
    ServerAliveCountMax 4
