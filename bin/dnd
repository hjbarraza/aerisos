#!/bin/bash
# aeris:summary=Do Not Disturb: state for the bar, or toggle
# aeris:group=toggle
# aeris:args=[toggle]
# Do Not Disturb (dunst). `dnd toggle` flips it; `dnd` prints Waybar JSON (hidden when off).

set -euo pipefail
if [[ ${1:-} == toggle ]]; then
  dunstctl set-paused toggle
  aeris-shell -q bar refresh
  exit
fi
if [[ $(dunstctl is-paused) == true ]]; then
  printf '{"text":"󰂛","class":"on","tooltip":"Do Not Disturb is on - click to turn off"}\n'
else
  printf '{"text":""}\n'
fi
