#!/bin/bash
# aeris:summary=Screenshot to ~/Pictures/Screenshots and the clipboard
# aeris:group=capture
# aeris:args=[area|screen|annotate]
# screenshot [area|screen|annotate] - saves to ~/Pictures/Screenshots and copies to clipboard
set -euo pipefail
dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots"
mkdir -p "$dir"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"

case "${1:-area}" in
  area)   geom=$(slurp -d -b '#00000066' -c '#ffffffcc' -w 1) || exit 0   # Esc cancels
          grim -g "$geom" "$file" ;;
  annotate) geom=$(slurp -d -b '#00000066' -c '#ffffffcc' -w 1) || exit 0
          grim -g "$geom" - | satty --filename - --output-filename "$file" --copy-command "wl-copy --type image/png" --early-exit --initial-tool arrow
          exit ;;
  screen) grim -o "$(hyprctl activeworkspace -j | python3 -c 'import json,sys; print(json.load(sys.stdin)["monitor"])')" "$file" ;;
esac

wl-copy --type image/png < "$file"
notify-send -i "$file" "Screenshot saved" "Copied to clipboard · $(basename "$file")"
