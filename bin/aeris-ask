#!/usr/bin/env python3
# aeris:summary=Drop-down terminal for quick questions to the local model (Ollama)
# aeris:group=intel
# aeris:args=[toggle [--selection]]
"""Quick questions to the local Ollama model, in a scratchpad terminal.

`aeris-ask toggle` (Win+` ) slides the terminal in and out, starting it on first use;
`aeris-ask toggle --selection` (Win+Shift+` ) also asks about the highlighted text.
`aeris-ask` alone is the chat loop that runs inside the terminal: type a question,
the answer streams back, the conversation is kept until `/new`.
Model: $AERIS_ASK_MODEL, else the first installed of the AERIS defaults.
"""

import json
import os
import select
import subprocess
import sys
import time
import urllib.request

OLLAMA = os.environ.get("OLLAMA_HOST", "http://127.0.0.1:11434")
if not OLLAMA.startswith("http"):
    OLLAMA = "http://" + OLLAMA
MODELS = ("qwen3.5:9b", "qwen3.5-9b-16k:latest", "gemma4:e4b", "gemma4:12b", "qwen3.5:4b")
CLASS = "aeris.ask"
SPECIAL = "ask"
FIFO = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "aeris-ask.fifo")
SYSTEM = ("You answer quick questions in a small terminal. Be brief and direct: a few lines, the "
          "answer first. Plain text, no tables, no headings. Give a shell command only when the "
          "question asks how to do something on a computer, and only one you are sure exists; "
          "never add unrelated commands or tips at the end.")
DIM, BOLD, RESET = "\033[2m", "\033[1m", "\033[0m"


def hypr(*args):
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True).stdout


def toggle(selection):
    """Show/hide the scratchpad; start the terminal if it isn't running."""
    if selection:
        text = subprocess.run(["wl-paste", "--primary", "--no-newline"],
                              capture_output=True, text=True).stdout.strip()
    running = any(c.get("class") == CLASS for c in json.loads(hypr("clients", "-j") or "[]"))
    shown = any(m.get("specialWorkspace", {}).get("name") == "special:" + SPECIAL
                for m in json.loads(hypr("monitors", "-j") or "[]"))
    if not running:
        # The window rule puts it on special:ask, which shows it
        subprocess.Popen(["ghostty", f"--class={CLASS}", "-e", sys.argv[0]],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    elif not (selection and shown):
        hypr("dispatch", f'hl.dsp.workspace.toggle_special("{SPECIAL}")')
    if selection and text:
        for _ in range(50):          # a fresh terminal needs a moment to open the FIFO
            try:
                fd = os.open(FIFO, os.O_WRONLY | os.O_NONBLOCK)
                break
            except OSError:
                time.sleep(0.1)
        else:
            return
        with os.fdopen(fd, "w") as f:
            f.write(json.dumps({"selection": text}) + "\n")


def pick_model():
    if os.environ.get("AERIS_ASK_MODEL"):
        return os.environ["AERIS_ASK_MODEL"]
    try:
        with urllib.request.urlopen(OLLAMA + "/api/tags", timeout=3) as r:
            have = {m["name"] for m in json.load(r)["models"]}
    except OSError:
        return None
    return next((m for m in MODELS if m in have), next(iter(sorted(have)), None))


def ask(model, history):
    body = json.dumps({"model": model, "messages": history, "stream": True, "think": False}).encode()
    req = urllib.request.Request(OLLAMA + "/api/chat", body, {"Content-Type": "application/json"})
    reply = []
    try:
        with urllib.request.urlopen(req, timeout=300) as r:
            for line in r:
                part = json.loads(line)
                chunk = part.get("message", {}).get("content", "")
                reply.append(chunk)
                print(chunk, end="", flush=True)
                if part.get("done"):
                    break
    except KeyboardInterrupt:
        print(f"{DIM} [stopped]{RESET}", end="")
    except OSError as e:
        print(f"{DIM}Ollama unreachable ({e}). `systemctl status ollama`{RESET}", end="")
        return None
    print("\n")
    return "".join(reply)


def loop():
    model = pick_model()
    if not model:
        print("No Ollama model available. Start it with `sudo systemctl start ollama`.")
    print(f"{BOLD}// ASK{RESET}  {DIM}{model or '-'} · /new clears · /model NAME switches · Win+` hides{RESET}\n")
    if os.path.exists(FIFO):
        os.unlink(FIFO)
    os.mkfifo(FIFO, 0o600)
    fifo = os.open(FIFO, os.O_RDONLY | os.O_NONBLOCK)
    keep = os.open(FIFO, os.O_WRONLY)  # holds the FIFO open so readers don't see EOF between writers
    history = [{"role": "system", "content": SYSTEM}]
    buf = b""
    while True:
        print(f"{BOLD}›{RESET} ", end="", flush=True)
        ready, _, _ = select.select([sys.stdin, fifo], [], [])
        if fifo in ready:
            buf += os.read(fifo, 65536)
            if b"\n" not in buf:
                continue
            line, buf = buf.split(b"\n", 1)
            sel = json.loads(line)["selection"]
            shown = sel if len(sel) < 300 else sel[:300] + "…"
            print(f"\r{DIM}[selection] {shown}{RESET}")
            q = input(f"{BOLD}› about this:{RESET} ").strip() or "Explain this."
            q = f"{q}\n\n---\n{sel}"
        else:
            q = sys.stdin.readline()
            if not q:
                break
            q = q.strip()
        if not q:
            continue
        if q == "/new":
            history = history[:1]
            print(f"{DIM}cleared{RESET}\n")
            continue
        if q.startswith("/model"):
            model = q.split(maxsplit=1)[1] if " " in q else pick_model()
            print(f"{DIM}model: {model}{RESET}\n")
            continue
        history.append({"role": "user", "content": q})
        print()
        reply = ask(model, history) if model else None
        if reply is None:
            history.pop()
        else:
            history.append({"role": "assistant", "content": reply})
    os.close(keep)


if __name__ == "__main__":
    if sys.argv[1:2] == ["toggle"]:
        toggle("--selection" in sys.argv)
    elif sys.argv[1:2] in (["-h"], ["--help"]):
        print(__doc__.strip())
    else:
        try:
            loop()
        except KeyboardInterrupt:
            pass
