#!/bin/bash
# aeris:summary=Orbit popup: map with ISS/Tiangong tracks and satellites overhead
# aeris:group=intel
# Orbit popup (quickshell): map with ISS/Tiangong tracks and satellites overhead. Click target of the
# bar's alert pill. Running it again while open closes it.
set -euo pipefail
dir="$HOME/.config/quickshell/aeris-orbit"
pidf="${XDG_RUNTIME_DIR:-/tmp}/aeris-orbit.pid"
comp="$HOME/.config/quickshell/aeris-screensaver/compute-tracks.py"

# already open? kill the popup's own qs; the launcher cleaning up behind it handles the rest.
if [ -s "$pidf" ] && kill -0 "$(cat "$pidf")" 2>/dev/null; then
    kill "$(cat "$pidf")"; exit 0
fi
rm -f "$pidf"

# fresh tracks, rewritten every 60 s — one daemon at a time, leave a foreign one alone
helper=""
if ! pgrep -f "compute-tracks.py" >/dev/null; then
    python3 "$comp" &
    helper=$!
fi
python3 "$dir/launches.py" &                                                  # launches: reused if < 25 min old
( while sleep 1800; do python3 "$dir/launches.py"; done ) & loop=$!
for _ in $(seq 20); do [ -s /tmp/aeris-screensaver-tracks.json ] && break; sleep 0.25; done

qs -p "$dir/shell.qml" & qspid=$!     # pid file holds qs, so the toggle closes the real thing
echo "$qspid" > "$pidf"
trap '[ -n "$helper" ] && kill "$helper" 2>/dev/null; kill "$loop" 2>/dev/null; rm -f "$pidf"' EXIT
wait "$qspid"
