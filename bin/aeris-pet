GREETINGS_FILE = os.path.expanduser("~/.config/tinyraven/greetings.txt")
FALLBACK_LINES = ["caw", "still here", "don't mind me"]
FEED_LINES = ["oh! crumbs.", "don't mind if i do", "a snack. the universe provides."]
NEW_WINDOW_LINES = ["ooh, a new window", "what's this, then?", "new room, same dragon"]
VOLUME = 0.35

BUBBLE_SECONDS = 5.0
