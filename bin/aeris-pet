FONT = "Die Grotesk 8"

# Dragon body: BODY_N spine points, BODY_SEG px apart, head first.
BODY_N = 16
BODY_SEG = 4.6
HEAD_R = 7.5
GROUND_PAD = 25                 # head centre sits this far above the bottom edge (legs stand under it)
WALK_SPEED = 26.0               # px per second
GOTO_SPEED = 40.0

# Legs: spine points the front and rear legs hang from, and bone lengths (px).
LEG_FRONT_AT = 3
