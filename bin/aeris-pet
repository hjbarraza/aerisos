# ---------------------------------------------------------------- helpers

def clamp(v, lo, hi):
    return max(lo, min(hi, v))


def load_lines():
    lines = []
    try:
        with open(GREETINGS_FILE, encoding="utf-8") as f:
            for raw in f:
                s = raw.strip()
                if s and not s.startswith("#"):
                    lines.append(s)
    except OSError:
        pass
    return lines or FALLBACK_LINES


def load_choice():
    kinds = [k for k, _ in PETS]
    env = os.environ.get("AERIS_PET")
    if env in kinds:
        return env
    try:
        with open(CHOICE_FILE, encoding="utf-8") as f:
            k = f.read().strip()
            if k in kinds:
                return k
    except OSError:
        pass
    return "dragon"


def save_choice(kind):
    try:
        os.makedirs(os.path.dirname(CHOICE_FILE), exist_ok=True)
        with open(CHOICE_FILE, "w", encoding="utf-8") as f:
            f.write(kind + "\n")
    except OSError:
        pass


def load_where():
    try:
        with open(WHERE_FILE, encoding="utf-8") as f:
            return "bar" if f.read().strip() == "bar" else "desktop"
    except OSError:
        return "desktop"


def save_where(where):
    os.makedirs(os.path.dirname(WHERE_FILE), exist_ok=True)
    with open(WHERE_FILE, "w", encoding="utf-8") as f:
        f.write(where + "\n")


def bar_shown():
    return not os.path.exists(BAR_HIDDEN_FILE)


def set_bar_shown(shown):
    if shown:
        try:
            os.remove(BAR_HIDDEN_FILE)
        except OSError:
            pass
    else:
        os.makedirs(os.path.dirname(BAR_HIDDEN_FILE), exist_ok=True)
        open(BAR_HIDDEN_FILE, "w").close()


def svg_path(d):
    """Parse an absolute M/L/C/Z path into (op, coords) pairs for cairo."""
    import re
    ops, cur, nums = [], None, []
    for tok in re.findall(r"[MLCZmlcz]|-?[0-9.]+", d):
        if tok.isalpha():
            if cur:
                ops.append((cur, nums))
            cur, nums = tok.upper(), []
        else:
            nums.append(float(tok))
    if cur:
        ops.append((cur, nums))
    return ops


def trace(cr, ops):
    for op, v in ops:
        if op == "M":
            cr.move_to(*v[:2])
        elif op == "L":
            cr.line_to(*v[:2])
        elif op == "C":
            cr.curve_to(*v[:6])
        elif op == "Z":
            cr.close_path()


def two_bone(root, target, l1, l2, bend):
    """Knee and end point of a two-bone limb reaching from root toward target.
    The knee goes to the side of the root->target line that `bend` points to."""
    dx, dy = target[0] - root[0], target[1] - root[1]
    d = math.hypot(dx, dy)
    if d < 1e-3:
        dx, dy, d = bend[0], bend[1], 1.0
    ux, uy = dx / d, dy / d
    d = clamp(d, abs(l1 - l2) + 0.5, l1 + l2 - 0.05)
    a = (l1 * l1 - l2 * l2 + d * d) / (2 * d)
    h = math.sqrt(max(0.0, l1 * l1 - a * a))
    px, py = -uy, ux
    if px * bend[0] + py * bend[1] < 0:
        px, py = -px, -py
    knee = (root[0] + ux * a + px * h, root[1] + uy * a + py * h)
    end = (root[0] + ux * d, root[1] + uy * d)
    return knee, end


# The raven, from ~/.local/share/aeris-pet/raven.svg (200x200, facing right). The wing is
# hinged at the shoulder (125,92) so it can flap.
