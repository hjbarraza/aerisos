FRONT_BONES = (9.5, 10.5)          # upper arm, forearm (elbow bends back)
REAR_BONES = (7.0, 7.5, 8.0)      # thigh (angled forward), shank, metatarsal (hock bends back)
STRIDE = 5.5                      # half a step, px

PETS = (("dragon", "Dragon"), ("raven", "Raven"))
