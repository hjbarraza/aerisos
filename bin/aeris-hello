#!/usr/bin/env python3
# aeris:summary=Spoken login greeting: time of day, date, a fun fact of the day
# aeris:group=voice
# aeris:args=[--text]
"""Spoken login greeting: time of day, the date and the fact of the day, read by Kokoro (bf_emma).

Run once per login from hyprland.lua. The fact is one per day: the bank below is shuffled once
with a fixed seed and indexed by the day number, so every day gets a different fact, the whole
bank comes around before any repeats, and every login on the same day says the same fact.
Speaking goes through aeris-speak (the system voice, Kokoro bf_emma when ~/.local/share/aeris/tts-models exists).

  aeris-hello            speak the greeting
  aeris-hello --text     only print it
"""
import datetime, fcntl, os, random, subprocess, sys, time

HOME = os.path.expanduser("~")
SPEAK = f"{HOME}/.local/bin/aeris-speak"
RUN = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
SEED = 2026  # fixed: changing it reshuffles the order (and so the day-to-fact mapping)

# Each fact is checked to be true. Add new ones at the end of their group; keep each under ~260 characters.
FACTS = [
    # Space
    "Sunlight takes about eight minutes and twenty seconds to reach Earth.",
    "A day on Venus is longer than its year.",
    "Olympus Mons on Mars is about 22 kilometres high, the tallest known volcano in the solar system.",
    "Footprints left on the Moon by Apollo astronauts may last for millions of years, since there is no wind or rain.",
    "The International Space Station orbits Earth about sixteen times a day, so its crew sees about sixteen sunrises.",
    "Voyager 1 crossed into interstellar space in 2012 and is still sending data back, from more than 20 billion kilometres away.",
    "A year on Mercury lasts only 88 Earth days.",
    "Neutron stars are so dense that a teaspoon of one would weigh billions of tonnes.",
    "Jupiter's Great Red Spot is a storm that has been observed for more than 150 years.",
    "Helium was discovered in the Sun's light before anyone found it on Earth.",

    # Earth and geography
    "Lightning strikes the Earth about forty-four times every second.",
    "Antarctica is the largest desert on Earth; it receives very little precipitation.",
    "Russia spans eleven time zones.",
    "Iceland has no mosquitoes.",
    "Australia is wider than the Moon.",
    "Vatican City is the smallest country in the world.",
    "Canada has more lakes than any other country, with over two million of them.",
    "Lake Baikal in Siberia holds about a fifth of the world's unfrozen fresh surface water.",
