#!/usr/bin/env python3
# aeris:summary=Spoken login greeting: time of day, date, a fun fact
# aeris:group=voice
# aeris:args=[--text]
"""Spoken login greeting: time of day, the date and a fun fact, read by Kokoro (bf_emma).

Run once per login from hyprland.lua. The fact comes from a free OpenRouter model, fresh at
every login, with a built-in list as fallback (no network, rate limit, odd answer). Speaking goes
through aeris-speak (the system voice, Kokoro bf_emma when ~/.local/share/aeris/tts-models exists).

  aeris-hello            speak the greeting
  aeris-hello --text     only print it
"""
import datetime, fcntl, json, os, random, re, subprocess, sys, time, urllib.request

HOME = os.path.expanduser("~")
SPEAK = f"{HOME}/.local/bin/aeris-speak"
MODEL = "nvidia/nemotron-3.5-lightning:free"   # free models only
RUN = os.environ.get("XDG_RUNTIME_DIR", "/tmp")

FALLBACK = [
    "Honey never spoils; edible honey has been found in ancient Egyptian tombs.",
    "Octopuses have three hearts and blue blood.",
    "A day on Venus is longer than its year.",
    "Bananas are berries, but strawberries are not.",
    "Wombats produce cube-shaped droppings.",
    "The Eiffel Tower grows about fifteen centimetres taller in summer heat.",
    "Sharks existed before trees did.",
    "There are more possible chess games than atoms in the observable universe.",
    "A group of flamingos is called a flamboyance.",
    "Lightning strikes the Earth about forty-four times every second.",
]


def ordinal(n):
    words = ("zeroth first second third fourth fifth sixth seventh eighth ninth tenth eleventh twelfth "
             "thirteenth fourteenth fifteenth sixteenth seventeenth eighteenth nineteenth twentieth").split()
    if n <= 20:
        return words[n]
    if n < 30:
        return "twenty-" + words[n - 20]
    return "thirtieth" if n == 30 else "thirty-first"


def key():
    try:
        for line in open(f"{HOME}/.env"):
            if line.startswith("OPENROUTER_KEY="):
                return line.split("=", 1)[1].strip().strip("\"'")
    except OSError:
        pass
    return os.environ.get("OPENROUTER_API_KEY", "")


def fetch_fact(today):
    k = key()
    if not k:
        return None
    prompt = (f"Today is {today:%A, %d %B}. Give ONE true, surprising fun fact, ideally tied to this date "
              "(an event or birthday on this day) or otherwise to science or nature. At most 30 words, one "
              "or two plain sentences, no markdown, no emoji, no preamble. Only state things you are sure of.")
    body = json.dumps({"model": MODEL, "max_tokens": 1500, "temperature": 0.8,
                       "messages": [{"role": "user", "content": prompt}]}).encode()
    req = urllib.request.Request("https://openrouter.ai/api/v1/chat/completions", body,
                                 {"Authorization": f"Bearer {k}", "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=25) as r:
            text = (json.load(r)["choices"][0]["message"].get("content") or "").strip()
    except Exception:
        return None
    text = re.sub(r"[*_`#>]+", "", text).replace("\n", " ").strip().strip('"')
    text = re.sub(r"[‐-―−]", "-", text).replace(" ", " ").replace(" ", " ")
    text = re.sub(r"^(fun fact|did you know)[:,]?\s*", "", text, flags=re.I)
    if 20 <= len(text) <= 260 and text[-1] in ".!":
        return text
    return None


def wait_for(ready, seconds):
    end = time.time() + seconds
    while time.time() < end:
        if ready():
            return True
        time.sleep(1)
    return ready()


def online():
    try:
        urllib.request.urlopen("https://openrouter.ai/api/v1/models", timeout=3).close()
        return True
    except Exception:
        return False


def main():
    today = datetime.date.today()
    lock = open(f"{RUN}/aeris-hello.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return  # already speaking

    if "--text" not in sys.argv:
        wait_for(online, 20)  # at login the network may still be coming up
    fact = fetch_fact(today) or random.choice(FALLBACK)

    hour = datetime.datetime.now().hour
    hello = "Good morning" if 5 <= hour < 12 else "Good afternoon" if 12 <= hour < 18 else "Good evening"
    text = (f"{hello}. Today is {today:%A}, the {ordinal(today.day)} of {today:%B}. "
            f"Fun fact: {fact}")
    print(text)
    if "--text" in sys.argv:
        return

    wait_for(lambda: subprocess.run(["pw-cli", "info", "0"], capture_output=True).returncode == 0, 20)
    if os.path.isfile(SPEAK):
        subprocess.run([SPEAK, text])   # the system voice; KeyError-style failures there are non-fatal


if __name__ == "__main__":
    main()
