def ordinal(n):
    words = ("zeroth first second third fourth fifth sixth seventh eighth ninth tenth eleventh twelfth "
             "thirteenth fourteenth fifteenth sixteenth seventeenth eighteenth nineteenth twentieth").split()
    if n <= 20:
        return words[n]
    if n < 30:
        return "twenty-" + words[n - 20]
    return "thirtieth" if n == 30 else "thirty-first"


def fact_of_the_day(today):
    order = list(range(len(FACTS)))
    random.Random(SEED).shuffle(order)
    epoch_day = (today - datetime.date(2026, 1, 1)).days
    return FACTS[order[epoch_day % len(FACTS)]]


def wait_for(ready, seconds):
    end = time.time() + seconds
    while time.time() < end:
        if ready():
            return True
        time.sleep(1)
    return ready()


def main():
    today = datetime.date.today()
    lock = open(f"{RUN}/aeris-hello.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return  # already speaking

    hour = datetime.datetime.now().hour
    hello = "Good morning" if 5 <= hour < 12 else "Good afternoon" if 12 <= hour < 18 else "Good evening"
    text = (f"{hello}. Today is {today:%A}, the {ordinal(today.day)} of {today:%B}. "
            f"Fun fact: {fact_of_the_day(today)}")
    print(text)
    if "--text" in sys.argv:
        return

    wait_for(lambda: subprocess.run(["pw-cli", "info", "0"], capture_output=True).returncode == 0, 20)
    if os.path.isfile(SPEAK):
        subprocess.run([SPEAK, text])   # the system voice; failures there are non-fatal


if __name__ == "__main__":
    main()
