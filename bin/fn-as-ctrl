#!/usr/bin/env python3
# aeris:summary=Razer Fn key also acts as Ctrl (Mac modifier row)
# aeris:group=system
"""The Razer Blade Fn key also acts as Ctrl, so the row left of the spacebar reads Ctrl, Ctrl, Option, Cmd.

The keyboard firmware owns the Fn layer (Fn + F-keys: volume, brightness) and sends no key for Fn itself,
but it does report Fn in a raw HID report: 04 0a ... when Fn goes down, 04 00 ... when it goes up
(measured 2026-11-16 on a Blade 17 2022). This program reads that report and holds Left Ctrl on a
virtual keyboard for as long as Fn is down. The firmware layer keeps working; Fn + F-key then arrives
as Ctrl + media key, which hyprland.lua binds as well.

Runs as the user service fn-as-ctrl.service (razer/, installed by ./setup.sh razer).
To undo: systemctl --user disable --now fn-as-ctrl
"""
import glob, os, select, sys
from evdev import UInput, ecodes

FN = 0x0A

paths = []
for d in glob.glob("/sys/class/hidraw/hidraw*"):          # the keyboard is several HID interfaces; numbers change per boot
    try:
        if "HID_ID=0003:00001532:" in open(d + "/device/uevent").read():   # USB, vendor Razer
            paths.append("/dev/" + os.path.basename(d))
    except OSError:
        pass
if not paths:
    sys.exit(0)                                           # not a Razer: nothing to do

fds = [os.open(p, os.O_RDONLY) for p in paths]
with UInput({ecodes.EV_KEY: [ecodes.KEY_LEFTCTRL]}, name="fn-as-ctrl") as ui:
    held = False
    while True:
        for fd in select.select(fds, [], [])[0]:
            report = os.read(fd, 64)                      # an unplug or suspend error ends the program; systemd restarts it
            if report[:1] != b"\x04":
                continue
            down = FN in report[1:]
            if down != held:
                held = down
                ui.write(ecodes.EV_KEY, ecodes.KEY_LEFTCTRL, int(down))
                ui.syn()
