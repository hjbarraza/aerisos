# Editor/backup leftovers (same as the snapshot EXCLUDES)
*.bak
*.bak[0-9]*
*.bak-*
*.pre-*
*.orig
__pycache__/
node_modules/

# Machine-local secrets: OpenCode service passwords are generated per machine
dotfiles/home/.config/opencode/service.json
dotfiles/home/.config/opencode/service-aeris.json
iso/out/

# Licensed Söhne fonts: kept on the machine, never published (setup.sh warns when missing)
dotfiles/home/.local/share/fonts/soehne/

# Claude Code: personal settings and skills stay on the machine
dotfiles/home/.claude/
