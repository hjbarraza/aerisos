#!/usr/bin/env bash
# AERIS bar, macOS port of rzr's quickshell bar (~/.config/quickshell/aeris/Bar).
# Layout: Æ + spaces left · clock centre · tailscale, network, volume, battery right.
# Colours and fonts from Commons/Theme.qml. One file: item scripts are inline.

BG=0xff0a0a0a FG=0xffe6e6e6 DIM=0xff7a7a7a WHITE=0xffffffff
SANS="Sohne" MONO="Söhne Mono" NERD="Symbols Nerd Font Mono"

sketchybar --bar height=26 position=top color=$BG border_width=0 shadow=off \
                 padding_left=12 padding_right=16 topmost=window sticky=on

sketchybar --default label.font="$MONO:Buch:11" label.color=$FG \
                     icon.font="$NERD:Regular:13" icon.color=$FG \
                     padding_left=0 padding_right=0 \
                     icon.padding_left=6 icon.padding_right=6 \
                     label.padding_left=6 label.padding_right=6

# ---- left: Æ mark
sketchybar --add item mark left \
           --set mark icon="Æ" icon.font="$SANS:Fett:15" icon.color=$WHITE \
                      icon.padding_left=0 icon.padding_right=10 label.drawing=off

# ---- left: spaces. Focused = 󱓻 in white, others = number (like Workspaces.qml)
for i in $(yabai -m query --spaces | jq '.[].index'); do
  sketchybar --add space space.$i left \
             --set space.$i space=$i icon=$i icon.font="$SANS:Buch:12" label.drawing=off \
                   script='if [ "$SELECTED" = true ]; then
                             sketchybar --set $NAME icon=󱓻 icon.font="'"$NERD"':Regular:12" icon.color='$WHITE'
                           else
                             sketchybar --set $NAME icon=${NAME#space.} icon.font="'"$SANS"':Buch:12" icon.color='$FG'
                           fi'
done

# ---- centre: clock, uppercase mono (like Clock.qml)
sketchybar --add item clock center \
           --set clock update_freq=30 icon.drawing=off \
                 script='sketchybar --set $NAME label="$(date "+%a %d %b  %H:%M" | tr a-z A-Z)"'

# ---- right (added right-to-left): battery, volume, network, tailscale
sketchybar --add item battery right \
           --set battery update_freq=120 label.drawing=off \
                 script='p=$(pmset -g batt | grep -o "[0-9]*%" | tr -d %); [ -z "$p" ] && exit 0
                         i=$(( p / 10 )); [ $i -gt 9 ] && i=9
                         if pmset -g batt | grep -q "AC Power"; then set=(󰢜 󰂆 󰂇 󰂈 󰢝 󰂉 󰢞 󰂊 󰂋 󰂅); else set=(󰁺 󰁻 󰁼 󰁽 󰁾 󰁿 󰂀 󰂁 󰂂 󰁹); fi
                         c='$FG'; [ $p -le 20 ] && c='$WHITE'
                         sketchybar --set $NAME icon=${set[$i]} icon.color=$c' \
           --subscribe battery power_source_change system_woke

sketchybar --add item volume right \
           --set volume label.drawing=off \
                 script='v=${INFO:-$(osascript -e "output volume of (get volume settings)")}
                         [ "$v" = 0 ] && sketchybar --set $NAME icon=󰖁 icon.color='$DIM' \
                                      || sketchybar --set $NAME icon=󰕾 icon.color='$FG \
           --subscribe volume volume_change

sketchybar --add item network right \
           --set network update_freq=30 label.drawing=off \
                 script='route -n get default >/dev/null 2>&1 \
                           && sketchybar --set $NAME icon=󰤨 icon.color='$FG' \
                           || sketchybar --set $NAME icon=󰤮 icon.color='$DIM \
           --subscribe network wifi_change system_woke

sketchybar --add item tailscale right \
           --set tailscale update_freq=30 label.drawing=off \
                 script='tailscale status >/dev/null 2>&1 \
                           && sketchybar --set $NAME icon=󰖂 icon.color='$FG' \
                           || sketchybar --set $NAME icon=󰖂 icon.color='$DIM \
                 click_script="open -a Tailscale"

sketchybar --update
