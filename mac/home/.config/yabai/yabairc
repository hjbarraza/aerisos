#!/usr/bin/env sh
# AERIS tiling, macOS port of rzr's Hyprland layout (dwindle, 8px grid, no borders).
# Runs with SIP on: tiling works; space switching and shadow removal do not.

yabai -m config layout bsp                 # = Hyprland dwindle
yabai -m config window_placement second_child
yabai -m config split_ratio 0.5

# 8px from the screen edge, 8px gutter between windows (same as rzr)
yabai -m config top_padding 8 bottom_padding 8 left_padding 8 right_padding 8
yabai -m config window_gap 8

# Leave room for the 26px sketchybar at the top
yabai -m config external_bar all:26:0

yabai -m config mouse_modifier ctrl        # ctrl + drag moves, ctrl + right-drag resizes
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize

# Small utility windows float, like rzr's float rules
yabai -m rule --add app="^(System Settings|Calculator|Archive Utility|App Store|Activity Monitor|Tailscale|Raycast)$" manage=off

# Tell the bar when spaces or windows change
yabai -m signal --add event=space_changed action="sketchybar --trigger space_change"

# Focus follows mouse (like Hyprland)
yabai -m config focus_follows_mouse autofocus

# Swiss grid: spaces turned on with `grid` re-tile when windows come and go
yabai -m signal --add label=grid_created event=window_created action="$HOME/.local/bin/grid --auto"
yabai -m signal --add label=grid_destroyed event=window_destroyed action="$HOME/.local/bin/grid --auto"
yabai -m signal --add label=grid_minimized event=window_minimized action="$HOME/.local/bin/grid --auto"
yabai -m signal --add label=grid_deminimized event=window_deminimized action="$HOME/.local/bin/grid --auto"

# New windows open on the screen under the mouse (the one you're working on), not the main screen.
yabai -m signal --add label=open_on_mouse_display event=window_created \
    action='export PATH=/opt/homebrew/bin:$PATH; D=$(yabai -m query --displays --display mouse | jq .index); [ "$(yabai -m query --windows --window $YABAI_WINDOW_ID | jq .display)" != "$D" ] && yabai -m window $YABAI_WINDOW_ID --display $D && yabai -m window --focus $YABAI_WINDOW_ID && $HOME/.local/bin/grid --auto'
