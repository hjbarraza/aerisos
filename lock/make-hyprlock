#!/usr/bin/env python3
"""Generate the AerisOS lock screen (hyprlock.conf) from the login screen's design grid.

Same 1600x900 design space as sddm/aeris/Main.qml, so both screens line up: wordmark,
tagline and rule at the top left with the WATCHLIST and WORLD feeds under them
(telegraphed one-line stories, bulleted, a blank row between stories); the password at
the top of the right column with the cards stacked under it, one key/value per row
(LOCATION, AIRSPACE, ORBIT, INTERNET, each trimmed to its essential fields). IDENTITY,
WEATHER, NETWORK and SECURITY are left out on purpose: the lock screen is what people
see when the laptop is left unattended.

Positions are written as percentages of the output, so they hold at any scale. Labels are
placed by baseline: hyprlock anchors a label's box by its top, so the top is the baseline
minus the font's ascent. Values come from /var/lib/aeris/lock.tsv (aeris-status) through
aeris-lock-field; nothing here calls a network API.

    make-hyprlock [OUTPUT]      default: ~/.config/hypr/hyprlock.conf
"""
import getpass
import os
import sys

W, H = 1600, 900
FONT_K = 1.2            # design px -> hyprlock font_size
LS_K = 1.6 * 1024       # design px -> letter_spacing: Pango takes 1/1024 device px (rounded to whole px), x1.6 output scale
ASCENT = {"Söhne Mono": 1.037, "Söhne": 1.171, "Source Han Sans JP": 1.160}   # hhea ascender / em
MONO, SANS, JP = "Söhne Mono", "Söhne", "Source Han Sans JP"
WHITE, GREY, DIM, HAIRLINE = "rgba(ffffffff)", "rgba(7a7a7aff)", "rgba(3a3a3aff)", "rgba(262626ff)"
FIELD = os.path.expanduser("~/.local/bin/aeris-lock-field")
REFRESH = 15000

# Grid, as in Main.qml
GRID_LEFT, GRID_RIGHT, INFO_RIGHT, PANEL = 96, 1504, 960, 1224
LINE_GAP, HEAD_GAP = 18, 26
RKEY_END, RVAL_AT = 1320, 1330   # right-column cards: keys flush right, values after
RCARD_GAP = 30                   # vertical space between stacked cards
LOGIN_HEAD, STATUS_BY, FIELD_W = 178, 280, 128   # beside the wordmark; status on its baseline
WATCH_HEAD = 348                          # watchlist feed under the wordmark's rule
WATCH_ROWS = 16                           # watch.1..16, as written by aeris-status
NEWS_HEAD = WATCH_HEAD + HEAD_GAP + WATCH_ROWS * LINE_GAP + 44    # 706: WORLD below the feed
NEWS_ROWS = 5                             # news.1..5, last line lands at 804
FEED_RIGHT = 1120                         # the feeds' fresh timestamps right-align here

out = []


def px(x):
    return f"{x / W * 100:.4f}%"


def py(y):
    return f"{y / H * 100:.4f}%"


def label(text, x, by, size, family=MONO, color=GREY, spacing=2.0, right=False, cmd=None, weight=None):
    top = by - ASCENT[family] * size
    # Exact size through Pango (font_size only takes whole numbers)
    attrs = f"size='{round(size * FONT_K * 1024)}' letter_spacing='{round(spacing * LS_K)}'"
    attrs += f" weight='{weight}'" if weight else ""
    if cmd:
        text = f'cmd[update:{REFRESH}] echo "<span {attrs}>$({FIELD} {cmd})</span>"'
    else:
        text = f"<span {attrs}>{text}</span>"
    out.append(f"""label {{
    monitor =
    text = {text}
    font_family = {family}
    font_size = {round(size * FONT_K)}
    color = {color}
    position = {"-" + px(W - x) if right else px(x)}, -{py(top)}
    halign = {"right" if right else "left"}
    valign = top
}}
""")


def rule(x, y, w, h, color):
    out.append(f"""shape {{
    monitor =
    size = {px(w)}, {py(h)}
    color = {color}
    rounding = 0
    border_size = 0
    position = {px(x)}, -{py(y)}
    halign = left
    valign = top
}}
""")


def head(x, by, name):
    label("//", x, by, 13, color=WHITE, spacing=0)
    label(name, x + 2 * 0.6 * 13 + 10, by, 11, color=WHITE)


def value(key, x, by, right=False):
    label("", x, by, 12, color=WHITE, spacing=1.5, right=right, cmd=key)


def rcard(cy, name, pairs, fresh):
    """One right-column card: head with its fetch time, then one (key, field) pair per row,
    the key flush right against its value. Returns the next card's top."""
    head(PANEL, cy, name)
    label("", GRID_RIGHT, cy, 11, right=True, cmd=fresh)
    for i, (key, field) in enumerate(pairs):
        ly = cy + HEAD_GAP + i * LINE_GAP
        label(key, RKEY_END, ly, 11, right=True)
        value(field, RVAL_AT, ly)
    return cy + HEAD_GAP + len(pairs) * LINE_GAP + RCARD_GAP


out.append("""# AerisOS lock screen. Generated by ~/aerisos/lock/make-hyprlock: edit that, not this.
general {
    hide_cursor = true
    ignore_empty_input = true
}

background {
    monitor =
    color = rgba(000000ff)
}
""")

# Top row
label("SYS/00", GRID_LEFT, 96, 11)
label("BUILD 2026.10", 960, 96, 11, right=True)
out.append(f"""label {{
    monitor =
    text = cmd[update:1000] echo "<span size='{round(11 * FONT_K * 1024)}' letter_spacing='{round(2 * LS_K)}'>$(date +'%a %d %b %Y   %H:%M' | tr '[:lower:]' '[:upper:]')</span>"
    font_family = {MONO}
    font_size = {round(11 * FONT_K)}
    color = {WHITE}
    position = -{px(W - GRID_RIGHT)}, -{py(96 - ASCENT[MONO] * 11)}
    halign = right
    valign = top
}}
""")

# Wordmark, tagline, rule, divider — higher than the login screen's 280/324/364
label("ÆRIS", 94, 224, 144, family=SANS, color=WHITE, spacing=-6)
label("OS", 460, 224, 144, family=SANS, color=WHITE, spacing=-6, weight="bold")
label("INTELLIGENCE OPERATING SYSTEM", GRID_LEFT, 268, 12, color=WHITE)
label("知能情報システム", 960, 268, 12, family=JP, right=True)
rule(GRID_LEFT, 308, 864, 1, WHITE)
rule(1160, 80, 1, 756, HAIRLINE)

# Feeds in the wide left column: watchlist, then the world news
head(GRID_LEFT, WATCH_HEAD, "WATCHLIST")
label("", FEED_RIGHT, WATCH_HEAD, 11, right=True, cmd="fresh.watch")
for i in range(1, WATCH_ROWS + 1):
    ly = WATCH_HEAD + HEAD_GAP + (i - 1) * LINE_GAP
    value(f"watch.{i}", GRID_LEFT, ly)
    label("", GRID_LEFT, ly, 11, cmd=f"watch.{i}s")

head(GRID_LEFT, NEWS_HEAD, "WORLD")
label("", FEED_RIGHT, NEWS_HEAD, 11, right=True, cmd="fresh.news")
for i in range(1, NEWS_ROWS + 1):
    ly = NEWS_HEAD + HEAD_GAP + (i - 1) * LINE_GAP
    value(f"news.{i}", GRID_LEFT, ly)
    label("", GRID_LEFT, ly, 11, cmd=f"news.{i}s")

# Cards stacked in the right column, under the password
cy = 324
cy = rcard(cy, "LOCATION", [("LAT", "location.lat"), ("LON", "location.lon"),
                            ("UTC", "location.utc")], "fresh.location")
cy = rcard(cy, "AIRSPACE", [("TRAFFIC", "air.traffic"), ("NEAREST", "air.nearest"),
                            ("GNSS", "air.gnss"), ("SQUAWK", "air.squawk")], "fresh.airspace")
cy = rcard(cy, "ORBIT", [("ISS", "orbit.iss"), ("CSS", "orbit.css"),
                         ("KP", "orbit.kp"), ("NOAA", "orbit.noaa"),
                         ("SATS", "orbit.sats"), ("LAUNCH", "orbit.launch"),
                         ("T-0", "orbit.t0")], "fresh.orbit")
rcard(cy, "INTERNET", [("OUTAGES", "internet.outages"), ("PING", "internet.ping")], "fresh.internet")
# Right column: password beside the wordmark, news from the tagline down
user_by = LOGIN_HEAD + HEAD_GAP + 2 * LINE_GAP          # 240
pass_x = GRID_RIGHT - FIELD_W
head(PANEL, LOGIN_HEAD, "AUTHENTICATE")
label("USER", PANEL, user_by - 2 * LINE_GAP, 11)
label(getpass.getuser().upper(), PANEL, user_by, 16, color=WHITE, spacing=2)
rule(PANEL, user_by + 12, FIELD_W, 1, DIM)
label("PASSWORD", pass_x, user_by - 2 * LINE_GAP, 11, color=WHITE)
rule(pass_x, user_by + 12, FIELD_W, 1, WHITE)
out.append(f"""input-field {{
    monitor =
    size = {px(FIELD_W)}, {py(28)}
    outline_thickness = 0
    rounding = 0
    inner_color = rgba(00000000)
    check_color = rgba(00000000)
    fail_color = rgba(00000000)
    capslock_color = rgba(ffffff26)    # Caps Lock: the field lights up faintly
    font_color = {WHITE}
    font_family = {MONO}
    fade_on_empty = false
    placeholder_text =
    fail_text = <span letter_spacing='{round(2 * LS_K)}'>ACCESS DENIED · $ATTEMPTS</span>
    dots_size = 0.22
    dots_spacing = 0.4
    dots_center = false
    position = {px(pass_x)}, -{py(user_by - 5 - 14)}
    halign = left
    valign = top
}}
""")
label("AWAITING AUTHENTICATION", PANEL, STATUS_BY, 11)
label("ENTER →", GRID_RIGHT, STATUS_BY, 12, right=True)


path = sys.argv[1] if len(sys.argv) > 1 else os.path.expanduser("~/.config/hypr/hyprlock.conf")
with open(path, "w") as f:
    f.write("\n".join(out))
print(f"wrote {path}: {sum(1 for o in out if o.startswith('label'))} labels")
