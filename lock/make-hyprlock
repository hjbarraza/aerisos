#!/usr/bin/env python3
"""Generate the AerisOS lock screen (hyprlock.conf) from the login screen's Swiss grid.

Same 1600x900 design space as sddm/aeris/Main.qml, so both screens line up. Columns: 12 on a
120 step from x=96 (88 wide, 32 gutters); feeds in columns 1-9 (96-1144), the password and
cards in columns 10-12 (1176-1504). Every text baseline sits on the 18 px grid 9 + 18n:

    top row 99        SYS/00 · date and time over the panel
    wordmark 243      ÆRIS OS; the password rule sits on its baseline
    tagline 297       and the lock status beside it
    rule 324          broken by the gutter between the two columns
    heads 369 ...     WATCHLIST and WORLD as tables (date | topic or outlet | telegram, unread
                      marked in the margin), the cards beside them (keys on column 10, values on
                      column 11, the password laid out the same way); hairlines between groups;
                      the last feed row and the last card row share a baseline (765)
    bottom row 819    build, under a hairline

IDENTITY, WEATHER, NETWORK and SECURITY are left out on purpose: the lock screen is what
people see when the laptop is left unattended.

Positions are written as percentages of the output, so they hold at any scale. Labels are
placed by baseline: hyprlock anchors a label's box by its top, so the top is the baseline
minus the font's ascent. Values come from /var/lib/aeris/lock.tsv (aeris-status) through
aeris-lock-field; nothing here calls a network API.

    make-hyprlock [OUTPUT]      default: ~/.config/hypr/hyprlock.conf
"""
import getpass
import os
import sys

W, H = 1600, 900
FONT_K = 1.2            # design px -> hyprlock font_size
LS_K = 1.6 * 1024       # design px -> letter_spacing: Pango takes 1/1024 device px (rounded to whole px), x1.6 output scale
ASCENT = {"Söhne Mono": 1.037, "Söhne": 1.171, "Source Han Sans JP": 1.160}   # hhea ascender / em
MONO, SANS, JP = "Söhne Mono", "Söhne", "Source Han Sans JP"
WHITE, GREY, READ, DIM = "rgba(ffffffff)", "rgba(7a7a7aff)", "rgba(c8c8c8ff)", "rgba(3a3a3aff)"
HAIRLINE = "rgba(2a2a2aff)"
FIELD = os.path.expanduser("~/.local/bin/aeris-lock-field")
REFRESH = 15000

# Grid, as in Main.qml
def col(n):
    return 96 + 120 * (n - 1)

GRID_LEFT, GRID_RIGHT = 96, 1504
FEED_RIGHT = 1144                # end of column 9
PANEL = col(10)                  # 1176
VALUE_AT = col(11)               # keys on column 10, values (and the password) on column 11
FEED_COLS = (col(1), col(2), col(4))         # date | topic or outlet | telegram
LINE = 18
TOP_ROW, BOTTOM_ROW = 99, 819
MARK_BY, TAG_BY, RULE_Y = 243, 297, 324
SECTION_TOP = 369
WATCH_ROWS, NEWS_ROWS = 16, 4    # watch.1..16 and news.1..4, as written by aeris-status
WORLD_HEAD = SECTION_TOP + (WATCH_ROWS + 2) * LINE   # 693

out = []


def px(x):
    return f"{x / W * 100:.4f}%"


def py(y):
    return f"{y / H * 100:.4f}%"


def label(text, x, by, size, family=MONO, color=GREY, spacing=2.0, right=False, cmd=None, weight=None, fg=None):
    """A label by baseline. cmd: a lock.tsv key printed live; fg: a lock.tsv key holding its
    colour (hex without #), overriding `color`."""
    top = by - ASCENT[family] * size
    # Exact size through Pango (font_size only takes whole numbers)
    attrs = f"size='{round(size * FONT_K * 1024)}' letter_spacing='{round(spacing * LS_K)}'"
    attrs += f" weight='{weight}'" if weight else ""
    attrs += f" foreground='#$({FIELD} {fg})'" if fg else ""
    if cmd:
        text = f'cmd[update:{REFRESH}] echo "<span {attrs}>$({FIELD} {cmd})</span>"'
    else:
        text = f"<span {attrs}>{text}</span>"
    out.append(f"""label {{
    monitor =
    text = {text}
    font_family = {family}
    font_size = {round(size * FONT_K)}
    color = {color}
    position = {"-" + px(W - x) if right else px(x)}, -{py(top)}
    halign = {"right" if right else "left"}
    valign = top
}}
""")


def clock(fmt, x, right=False):
    attrs = f"size='{round(11 * FONT_K * 1024)}' letter_spacing='{round(2 * LS_K)}'"
    out.append(f"""label {{
    monitor =
    text = cmd[update:1000] echo "<span {attrs}>$(date +'{fmt}' | tr '[:lower:]' '[:upper:]')</span>"
    font_family = {MONO}
    font_size = {round(11 * FONT_K)}
    color = {WHITE}
    position = {"-" + px(W - x) if right else px(x)}, -{py(TOP_ROW - ASCENT[MONO] * 11)}
    halign = {"right" if right else "left"}
    valign = top
}}
""")


def rule(x, y, w, h, color):
    out.append(f"""shape {{
    monitor =
    size = {px(w)}, {py(h)}
    color = {color}
    rounding = 0
    border_size = 0
    position = {px(x)}, -{py(y)}
    halign = left
    valign = top
}}
""")


def head(x, by, name, right, fresh):
    """Section head: // and the name in white, its fetch time right-aligned on the baseline."""
    label(f"//  {name}", x, by, 11, color=WHITE)
    label("", right, by, 11, right=True, cmd=fresh)


def hairline(x0, x1, by):
    """The hairline above a group's head (or the bottom row), 21 above its baseline."""
    rule(x0, by - 21, x1 - x0, 1, HAIRLINE)


def card(cy, name, pairs, fresh, first=False):
    """One right-column card: its rows directly under the head, keys on column 10, values on
    column 11, a hairline above unless it opens the column. Returns the next card's head, one
    blank row further."""
    if not first:
        hairline(PANEL, GRID_RIGHT, cy)
    head(PANEL, cy, name, GRID_RIGHT, fresh)
    for i, (key, field) in enumerate(pairs, 1):
        label(key, PANEL, cy + i * LINE, 11)
        label("", VALUE_AT, cy + i * LINE, 12, color=WHITE, spacing=1.5, cmd=field)
    return cy + (len(pairs) + 2) * LINE


out.append("""# AerisOS lock screen. Generated by ~/aerisos/lock/make-hyprlock: edit that, not this.
general {
    hide_cursor = true
    ignore_empty_input = true
}

background {
    monitor =
    color = rgba(000000ff)
}
""")

# Top row
label("SYS/00", GRID_LEFT, TOP_ROW, 11)
clock("%a %d %b %Y", PANEL)
clock("%H:%M", GRID_RIGHT, right=True)

# Wordmark, tagline, rule (broken by the gutter)
label("ÆRIS", 94, MARK_BY, 144, family=SANS, color=WHITE, spacing=-6)
label("OS", 460, MARK_BY, 144, family=SANS, color=WHITE, spacing=-6, weight="bold")
label("INTELLIGENCE OPERATING SYSTEM", GRID_LEFT, TAG_BY, 12, color=WHITE)
label("知能情報システム", FEED_RIGHT, TAG_BY, 12, family=JP, right=True)
rule(GRID_LEFT, RULE_Y, FEED_RIGHT - GRID_LEFT, 1, WHITE)
rule(PANEL, RULE_Y, GRID_RIGHT - PANEL, 1, WHITE)

# Feeds: watchlist, then the world news, as tables
head(GRID_LEFT, SECTION_TOP, "WATCHLIST", FEED_RIGHT, "fresh.watch")
for i in range(1, WATCH_ROWS + 1):
    ly = SECTION_TOP + i * LINE
    label("", GRID_LEFT - 15, ly - 1, 7, color=WHITE, spacing=0, cmd=f"watch.{i}m")   # unread, in the margin
    label("", FEED_COLS[0], ly, 11, cmd=f"watch.{i}d", fg=f"watch.{i}dc")
    label("", FEED_COLS[1], ly, 11, cmd=f"watch.{i}t")
    label("", FEED_COLS[2], ly, 12, spacing=1.5, cmd=f"watch.{i}h", fg=f"watch.{i}hc")

hairline(GRID_LEFT, FEED_RIGHT, WORLD_HEAD)
head(GRID_LEFT, WORLD_HEAD, "WORLD", FEED_RIGHT, "fresh.news")
for i in range(1, NEWS_ROWS + 1):
    ly = WORLD_HEAD + i * LINE
    label("", FEED_COLS[0], ly, 11, cmd=f"news.{i}d")
    label("", FEED_COLS[1], ly, 11, cmd=f"news.{i}t")
    label("", FEED_COLS[2], ly, 12, color=READ, spacing=1.5, cmd=f"news.{i}h")

# Cards in the right column, under the password
cy = SECTION_TOP
cy = card(cy, "LOCATION", [("LAT", "location.lat"), ("LON", "location.lon"),
                           ("UTC", "location.utc")], "fresh.location", first=True)
cy = card(cy, "AIRSPACE", [("TRAFFIC", "air.traffic"), ("NEAREST", "air.nearest"),
                           ("GNSS", "air.gnss"), ("SQUAWK", "air.squawk")], "fresh.airspace")
cy = card(cy, "ORBIT", [("ISS", "orbit.iss"), ("CSS", "orbit.css"),
                        ("KP", "orbit.kp"), ("NOAA", "orbit.noaa"),
                        ("SATS", "orbit.sats"), ("LAUNCH", "orbit.launch"),
                        ("T-0", "orbit.t0")], "fresh.orbit")
card(cy, "INTERNET", [("OUTAGES", "internet.outages"), ("PING", "internet.ping")], "fresh.internet")

# Login rows laid out like card rows: USER two lines above PASSWORD, whose dots sit on the
# wordmark's baseline; underlines 7 below, under the value column; status on the tagline's
user_by = MARK_BY - 2 * LINE
label("//  AUTHENTICATE", PANEL, MARK_BY - 3 * LINE, 11, color=WHITE)
label("USER", PANEL, user_by, 11)
label(getpass.getuser(), VALUE_AT, user_by, 12, color=WHITE, spacing=1.5)
rule(VALUE_AT, user_by + 7, GRID_RIGHT - VALUE_AT, 1, DIM)
label("PASSWORD", PANEL, MARK_BY, 11)
rule(VALUE_AT, MARK_BY + 7, GRID_RIGHT - VALUE_AT, 1, WHITE)
out.append(f"""input-field {{
    monitor =
    size = {px(GRID_RIGHT - VALUE_AT)}, {py(28)}
    outline_thickness = 0
    rounding = 0
    inner_color = rgba(00000000)
    check_color = rgba(00000000)
    fail_color = rgba(00000000)
    capslock_color = rgba(ffffff26)    # Caps Lock: the field lights up faintly
    font_color = {WHITE}
    font_family = {MONO}
    fade_on_empty = false
    placeholder_text =
    fail_text = <span letter_spacing='{round(2 * LS_K)}'>ACCESS DENIED · $ATTEMPTS</span>
    dots_size = 0.22
    dots_spacing = 0.4
    dots_center = false
    position = {px(VALUE_AT)}, -{py(MARK_BY - 5 - 14)}
    halign = left
    valign = top
}}
""")
label("AWAITING AUTHENTICATION", PANEL, TAG_BY, 11)
label("ENTER →", GRID_RIGHT, TAG_BY, 11, right=True)

# Bottom row, under hairlines in both columns
hairline(GRID_LEFT, FEED_RIGHT, BOTTOM_ROW)
hairline(PANEL, GRID_RIGHT, BOTTOM_ROW)
label("BUILD 2026.10", GRID_LEFT, BOTTOM_ROW, 11)


path = sys.argv[1] if len(sys.argv) > 1 else os.path.expanduser("~/.config/hypr/hyprlock.conf")
with open(path, "w") as f:
    f.write("\n".join(out))
print(f"wrote {path}: {sum(1 for o in out if o.startswith('label'))} labels")
